---
import Arrow from './Arrow.astro';
import Folio from './Folio.astro';
import { projects } from '../data/projects';
import type { Project } from '../data/projects';
import { counts } from '../utils/site';

const featured = projects.filter((project) => project.featured);

const pad = (n: number): string => String(n).padStart(2, '0');
const shotsOf = (project: Project): string[] =>
  project.images?.length ? project.images : project.image ? [project.image] : [];
// 'Apache Kafka, React +5': the first two technologies and how many more the panel lists
const stackOf = (tech: string[]): string =>
  tech.length > 2 ? `${tech[0]}, ${tech[1]} +${tech.length - 2}` : tech.join(', ');

const peekSrc = encodeURI(shotsOf(featured[0])[0] ?? '');
---

<section id="work" class="sec work" data-folio="Work" aria-labelledby="work-title">
  <div class="wrap work-head">
    <Folio name="Work" datum={`${counts.projects} projects`} />
    <h2 class="t-title work-title" id="work-title">
      <span data-split>Work</span><span class="sup" aria-hidden="true" data-rise
        >{counts.projects}</span
      >
    </h2>
    <p class="t-body work-deck" data-split>
      Streaming pipelines, an assessment platform, document AI, booking systems and a fine-tuning
      pipeline. Each project carries its screenshots.
    </p>
  </div>

  <ol class="work-index">
    {
      featured.map((project, i) => {
        const shots = shotsOf(project);
        const open = i === 0;
        return (
          <li class="work-row" data-rise>
            <h3>
              <button
                type="button"
                class="row-head"
                aria-expanded={open ? 'true' : 'false'}
                aria-controls={`work-panel-${i}`}
                aria-labelledby={`work-name-${i}`}
                aria-describedby={`work-desc-${i}`}
                data-peek={shots[0] ? encodeURI(shots[0]) : undefined}
              >
                <span class="row-no mono" aria-hidden="true">
                  {pad(i + 1)}
                </span>
                <span class="row-name t-h3" id={`work-name-${i}`}>
                  {project.title}
                </span>
                <span class="row-desc t-body" id={`work-desc-${i}`}>
                  {project.description}
                </span>
                <span class="row-end">
                  <span class="row-stack mono-data" aria-hidden="true">
                    {stackOf(project.tech)}
                  </span>
                  <span class="mark" aria-hidden="true" />
                </span>
              </button>
            </h3>

            <div
              class="row-panel"
              id={`work-panel-${i}`}
              role="region"
              aria-labelledby={`work-name-${i}`}
            >
              <div class="panel-body">
                <div class="panel-copy">
                  <p class="t-body">{project.longDescription}</p>
                  <p class="mono-data">{project.tech.join(', ')}</p>
                  {(project.github || project.live || project.video) && (
                    <p class="panel-links">
                      {project.github && (
                        <a
                          class="link"
                          href={project.github}
                          target="_blank"
                          rel="noopener"
                          aria-label={`${project.title} source`}
                        >
                          Source
                          <Arrow dir="up-right" />
                        </a>
                      )}
                      {project.live && (
                        <a
                          class="link"
                          href={project.live}
                          target="_blank"
                          rel="noopener"
                          aria-label={`${project.title} live site`}
                        >
                          Live
                          <Arrow dir="up-right" />
                        </a>
                      )}
                      {project.video && (
                        <a
                          class="link"
                          href={encodeURI(project.video)}
                          target="_blank"
                          rel="noopener"
                          aria-label={`${project.title} demo video`}
                        >
                          Demo
                          <Arrow dir="up-right" />
                        </a>
                      )}
                    </p>
                  )}
                </div>

                {shots.length > 0 && (
                  <div class="panel-shots">
                    <ul class="rail" tabindex="0" aria-label={`${project.title} screenshots`}>
                      {shots.map((src, n) => (
                        <li class="plate">
                          <img
                            src={encodeURI(src)}
                            width="640"
                            height="400"
                            loading="lazy"
                            decoding="async"
                            alt={`${project.title}, screen ${n + 1}`}
                          />
                        </li>
                      ))}
                    </ul>
                    <p class="mono shots-caption">Fig. 1 of {shots.length}</p>
                  </div>
                )}
              </div>
            </div>
          </li>
        );
      })
    }
  </ol>

  <div class="peek plate" aria-hidden="true">
    <img src={peekSrc} width="300" height="188" loading="lazy" decoding="async" alt="" />
  </div>
</section>

<style>
  .work {
    --bleed: 16px;
  }
  @media (max-width: 599px) {
    .work {
      --bleed: 12px;
    }
  }

  /* ---- Header: title on columns 1 to 7, deck on 9 to 12 once there is room ---- */
  /* The count sits outside the split element: SplitText would otherwise put it on a second line
     whenever the page is laid out away from the top (reload, Back, resize) */
  .work-title {
    display: flex;
    align-items: flex-start;
    grid-column: 1 / -1;
    margin: 0;
  }
  .work-deck {
    grid-column: 1 / -1;
    max-width: 38ch;
    margin: 2rem 0 0;
    color: var(--paper-2);
  }
  @media (min-width: 1100px) {
    .work-title {
      grid-column: 1 / 8;
    }
    .work-deck {
      grid-column: 9 / -1;
      align-self: end;
      margin: 0 0 0.75rem;
    }
  }

  /* ---- Index ---- */
  .work-index {
    overflow-anchor: none; /* work.ts keeps the clicked head still itself */
    list-style: none;
    width: min(100% - 2 * var(--gutter), var(--wrap-max));
    margin: clamp(3.5rem, 7vw, 6rem) auto 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
  .work-row {
    position: relative;
    isolation: isolate;
    border-top: 1px solid var(--rule);
  }
  .work-row h3 {
    margin: 0;
  }
  /* The open row is one raised surface that bleeds past the columns; its text stays on the grid */
  .work-row::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--bleed));
    z-index: -1;
  }
  .work-row:has(> h3 > .row-head[aria-expanded='true'])::before {
    background: var(--ink-1);
  }

  /* ---- Row head: phone first ---- */
  .row-head {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    width: 100%;
    min-height: 64px;
    padding: 1rem 0;
    text-align: left;
    color: var(--paper);
  }
  .row-head::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--bleed));
    z-index: -1;
    background: var(--ink-2);
    opacity: 0;
  }
  .row-no {
    grid-column: 1;
    grid-row: 1;
  }
  .row-name {
    grid-column: 2;
    grid-row: 1;
  }
  .row-desc {
    grid-column: 2;
    grid-row: 2;
    margin-top: 0.5rem;
    color: var(--paper-2);
  }
  .row-end {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-self: start;
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--gap);
    padding: 0.4rem 0 0 var(--gap);
  }
  .row-stack {
    display: none;
    text-align: right;
  }

  /* The mark is a plus drawn from two hairlines; open, it turns into a cross and takes the accent */
  .mark {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 1px;
    color: var(--paper-2);
  }
  .mark::before,
  .mark::after {
    content: '';
    position: absolute;
    background: currentColor;
  }
  .mark::before {
    inset: 50% 0 auto;
    height: 1px;
  }
  .mark::after {
    inset: 0 auto 0 50%;
    width: 1px;
  }
  .row-head[aria-expanded='true'] .mark {
    transform: rotate(45deg);
    color: var(--accent);
  }

  @media (min-width: 900px) {
    .row-head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      min-height: 96px;
      padding-block: 1.75rem;
    }
    .row-name {
      grid-column: 2 / 7;
    }
    .row-desc {
      grid-column: 7 / 12;
      grid-row: 1;
      margin-top: 0;
    }
    .row-end {
      grid-column: 12;
      grid-row: 1;
      align-self: baseline;
      padding: 0;
    }
  }
  @media (min-width: 1100px) {
    .row-desc {
      grid-column: 7 / 11;
    }
    .row-end {
      grid-column: 11 / -1;
    }
    .row-stack {
      display: block;
    }
  }

  @media (hover: hover) {
    .row-head:hover::before {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .row-head::before {
      transition: opacity 0.3s;
    }
    .mark {
      transition:
        transform 0.4s cubic-bezier(0.215, 0.61, 0.355, 1),
        color 0.3s;
    }
  }

  /* ---- Panel. Only a page that can run script may hide the closed ones; the height and the
     display are tweened inline by work.ts and handed back to these rules when the tween ends ---- */
  @media (scripting: enabled) {
    .work-row:has(> h3 > .row-head[aria-expanded='false']) > .row-panel {
      display: none;
    }
  }
  @media (scripting: none) {
    .mark {
      display: none;
    }
  }
  .row-panel {
    margin-inline: calc(-1 * var(--bleed));
    padding-inline: var(--bleed);
    background: var(--ink-1);
  }
  .panel-body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 2rem;
    padding-block: 1.5rem 2rem;
  }
  .panel-copy,
  .panel-shots {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .panel-copy {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .panel-copy p {
    margin: 0;
  }
  .panel-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
    font-family: var(--serif);
    font-size: var(--t-body);
  }
  .panel-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (min-width: 900px) {
    .panel-body {
      padding-block: 2rem 2.5rem;
    }
    .panel-copy,
    .panel-shots {
      grid-column: 2 / -1;
    }
  }
  @media (min-width: 1100px) {
    .panel-copy {
      grid-column: 2 / 6;
      padding-right: var(--gap);
    }
    .panel-shots {
      grid-column: 6 / -1;
    }
  }

  /* ---- Rail: native scroll-snap, one plate per figure ---- */
  .rail {
    display: flex;
    gap: var(--gap);
    margin: 0;
    padding: 0 0 1rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--rule-strong) transparent;
  }
  .rail .plate {
    flex: none;
    width: min(82%, 544px);
    aspect-ratio: 16 / 10;
    scroll-snap-align: start;
  }
  .rail .plate img {
    object-position: top center;
  }
  .rail:focus-visible .plate img {
    filter: none;
  }
  @media (min-width: 900px) {
    .rail .plate {
      width: auto;
      height: 340px;
    }
  }
  .shots-caption {
    margin: 0.5rem 0 0;
  }

  /* ---- Peek: one plate that follows the pointer; work.ts turns it on for a fine pointer only ---- */
  .peek {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 3;
    display: none;
    width: 300px;
    height: 188px;
    pointer-events: none;
  }
</style>
