---
import Arrow from './Arrow.astro';
import Folio from './Folio.astro';
import { ventures } from '../data/ventures';

// The Drive venture stays in the data because the game imports it, but it is not shown here
const axiom = ventures.find((v) => v.id === 'axiom');
if (!axiom?.video || !axiom.poster) {
  throw new Error("Ventures: the 'axiom' entry in src/data/ventures.ts needs a video and a poster");
}
const { name, tagline, blurb, url, cta, tags, video, poster } = axiom;
---

<section id="ventures" class="sec" data-folio="Ventures">
  <Folio name="Ventures" datum="Owned" />

  <div class="wrap">
    <div class="copy">
      <p class="mono" data-rise>{tagline}</p>
      <h2 class="t-title" data-split>{name}</h2>
      <p class="t-body blurb" data-split>{blurb}</p>
      <p class="mono-data tags" data-rise>{tags.join(', ')}</p>
      <p class="open" data-rise>
        <a class="link" href={url} target="_blank" rel="noopener">{cta}<Arrow dir="up-right" /></a>
      </p>
    </div>

    <figure class="mat" data-plate>
      <video
        muted
        loop
        playsinline
        controls
        preload="none"
        src={video}
        poster={poster}
        width="1280"
        height="720"
      ></video>
      <figcaption class="t-caption">Fig. Axiom billing platform, demo loop</figcaption>
    </figure>
  </div>
</section>

<style>
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .copy h2 {
    margin-top: 24px;
  }
  .blurb {
    margin-top: 32px;
    margin-bottom: 40px;
    color: var(--paper-2);
  }
  /* The tags and the link settle to the foot of the page, level with the caption on the facing one */
  .tags {
    align-self: stretch;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  .open {
    margin-top: 24px;
  }
  .open .link {
    font-size: var(--t-standfirst);
    line-height: 1.35;
  }

  .mat {
    margin: 0 0 40px;
    padding: 12px;
    background: var(--ink-2);
    border: 1px solid var(--rule);
    order: -1;
  }
  /* The box is sized by the ratio, not by the file, so it is the same height before and after the video loads */
  .mat video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--ink-0);
  }
  .mat figcaption {
    margin-top: 12px;
    color: var(--paper-2);
  }

  @media (min-width: 900px) {
    .copy {
      grid-column: 1 / 6;
      grid-row: 1;
      padding-inline-end: var(--gap);
    }
    .mat {
      grid-column: 6 / -1;
      grid-row: 1;
      align-self: start;
      margin-bottom: 0;
      order: 0;
    }
  }
</style>
