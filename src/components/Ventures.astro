---
import { ventures } from '../data/ventures';

const axiom = ventures.find((v) => v.id === 'axiom')!;
const rest = ventures.filter((v) => v.id !== 'axiom');
---

<section id="ventures" class="ventures">
  <div class="shell">
    <header class="ventures-head">
      <p class="t-eyebrow reveal">Mine</p>
      <h2 class="t-headline t-shine reveal" style="--d:80ms">
        Not client work.<br />Things I own.
      </h2>
    </header>

    <!-- Axiom leads: it is the one with a product behind it -->
    <article class="lead card reveal" style="--d:140ms">
      <div class="lead-media">
        <video
          src={axiom.video}
          poster={axiom.poster}
          muted
          loop
          playsinline
          controls
          preload="none"
          data-venture-video
        ></video>
      </div>

      <div class="lead-copy">
        <p class="t-eyebrow">{axiom.tagline}</p>
        <h3 class="t-title">{axiom.name}</h3>
        <p class="t-body">{axiom.blurb}</p>

        <ul class="tags">
          {axiom.tags.map((t) => <li>{t}</li>)}
        </ul>

        <div class="lead-links">
          <a class="btn btn-primary" href={axiom.url} target="_blank" rel="noopener">
            {axiom.cta}
          </a>
          <a class="link-arrow" href="#sites">See what it ships</a>
        </div>
      </div>
    </article>

    <ul class="others">
      {
        rest.map((v, i) => (
          <li class="reveal" style={`--d:${200 + i * 80}ms`}>
            <article class="card other">
              <p class="t-eyebrow">{v.tagline}</p>
              <h3 class="t-title">{v.name}</h3>
              <p class="t-body">{v.blurb}</p>
              <ul class="tags">
                {v.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
              <a
                class="link-arrow"
                href={v.url}
                target={v.external ? '_blank' : undefined}
                rel={v.external ? 'noopener' : undefined}
              >
                {v.cta}
              </a>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // preload="none" keeps 3 MB off the initial load; fetch it only once the
  // player is actually on screen, and pause again when it leaves.
  const video = document.querySelector<HTMLVideoElement>('[data-venture-video]');
  if (video) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (video.preload === 'none') video.preload = 'metadata';
          void video.play().catch(() => {
            /* autoplay refused: the poster stays, controls still work */
          });
        } else {
          video.pause();
        }
      },
      { threshold: 0.35 }
    ).observe(video);
  }
</script>

<style>
  .ventures {
    padding-block: clamp(5rem, 12vw, 9rem);
    border-top: 1px solid var(--hairline);
  }

  .ventures-head {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .ventures-head h2 {
    margin: 0.5rem 0 0;
  }

  .lead {
    display: grid;
    gap: 0;
    background: linear-gradient(180deg, #161618, #0c0c0e);
    margin-bottom: 1rem;
  }

  .lead-media {
    background: #000;
    display: flex;
  }
  .lead-media video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .lead-copy {
    display: grid;
    gap: 0.9rem;
    align-content: center;
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }
  .lead-copy h3,
  .lead-copy p {
    margin: 0;
  }
  .lead-copy .t-body {
    max-width: 52ch;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .lead-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
  }
  .tags li {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--hairline);
    border-radius: 980px;
    background: rgba(255, 255, 255, 0.03);
  }

  .others {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .other {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: linear-gradient(180deg, #131315, #0b0b0d);
  }
  .other h3,
  .other p {
    margin: 0;
  }
  .other .t-body {
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .other .link-arrow {
    margin-top: 0.4rem;
  }

  @media (min-width: 900px) {
    .lead {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }
</style>
