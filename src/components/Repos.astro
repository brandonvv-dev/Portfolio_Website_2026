---
import Arrow from './Arrow.astro';
import Folio from './Folio.astro';
import { profileUrl, timeAgo } from '../utils/github';
import type { GitHubRepo } from '../utils/github';

interface Props {
  repos: GitHubRepo[];
}

const { repos } = Astro.props;

const snapshot = new Intl.DateTimeFormat('en-ZA', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(new Date());
---

{
  repos.length > 0 && (
    <section id="open-source" class="sec" data-folio="Source">
      <Folio name="Source" datum={`Snapshot at build, ${snapshot}`} />
      <h2 class="sr-only">Open source repositories</h2>
      <div class="wrap">
        <ol class="repos">
          {repos.map((r) => (
            <li data-rise>
              <a class="repo-row" href={r.html_url} target="_blank" rel="noopener">
                <span class="repo-name">
                  {r.name}
                  <span class="repo-go">
                    <Arrow dir="up-right" />
                  </span>
                </span>
                {r.description && <span class="repo-desc t-body">{r.description}</span>}
                <span class="repo-meta mono-data">
                  {r.language && <span>{r.language}</span>}
                  <span class="repo-date">Updated {timeAgo(r.updated_at)}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
        <p class="repos-all">
          <a class="link t-body" href={profileUrl} target="_blank" rel="noopener">
            All repositories<Arrow dir="up-right" />
          </a>
        </p>
      </div>
    </section>
  )
}

<style>
  .repos {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .repos > li {
    border-top: 1px solid var(--rule);
  }
  .repos > li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  /* The row reaches 12px past the grid on each side so its hover fill has room around the text */
  .repo-row {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-height: 56px;
    margin-inline: -12px;
    padding: 1.25rem 12px;
    transition: background-color 0.3s;
  }
  .repo-row:is(:hover, :focus-visible) {
    background: var(--ink-2);
  }

  .repo-name {
    font-family: var(--serif);
    font-size: 1.375rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    transition: transform 0.3s;
  }
  .repo-row:is(:hover, :focus-visible) .repo-name {
    transform: translateX(8px);
  }
  .repo-go {
    margin-left: 0.5em;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .repo-row:is(:hover, :focus-visible) .repo-go {
    opacity: 1;
  }

  .repo-desc {
    color: var(--paper-2);
  }

  .repo-meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
    row-gap: 0.25rem;
  }
  .repo-date {
    margin-left: auto;
    text-align: right;
  }

  .repos-all {
    grid-column: 1 / -1;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
  }

  @media (min-width: 900px) {
    .repo-row {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: baseline;
      padding-block: 1.5rem;
    }
    .repo-name {
      grid-column: 1 / 5;
    }
    .repo-desc {
      grid-column: 5 / 10;
    }
    .repo-meta {
      grid-column: 10 / -1;
    }
  }

  @media (hover: none) {
    .repo-go {
      opacity: 1;
    }
  }

</style>
