---
import Arrow from './Arrow.astro';
import Folio from './Folio.astro';
import ScrollReveal from './bits/ScrollReveal';
import { cv } from '../utils/site';

const statement =
  'I work across React, Next.js, Node, Python, C# and C++, with a deep seam in ASP.NET migration and a working practice in applied AI. The common thread is maintainability: clear boundaries, honest error handling, and code the next person can read at 3am without a guide.';

const chapters = [
  {
    title: 'Full-stack & AI engineering',
    body: 'Building production systems end to end: modern frontends, scalable APIs, and models wired into features people actually press buttons on.',
  },
  {
    title: '.NET Framework 4',
    to: '.NET 8',
    body: 'Migrating legacy ASP.NET estates onto modern .NET with strict architecture standards: clear boundaries, testable seams, no rewrite-by-vibes.',
  },
  {
    title: 'Streaming at 10k events/sec',
    body: 'Kafka pipelines feeding real-time dashboards, with anomaly detection and alerting that holds up under load rather than in a demo.',
  },
  {
    title: 'Fine-tuning that pays for itself',
    body: 'LoRA/QLoRA pipelines with automated evaluation and a measured 60% lower training cost.',
  },
];

const stack = [
  'React', 'Next.js', 'TypeScript', '.NET', 'C++', 'Python', 'Astro', 'Node.js',
  'PostgreSQL', 'Docker', 'Apache Kafka', 'PyTorch', 'Tailwind CSS', 'Redis', 'FastAPI', 'Git',
];
---

<section id="about" class="sec" data-folio="About">
  <h2 class="sr-only">About</h2>
  <Folio name="About" datum="Full-stack and AI" />

  <div class="wrap">
    <figure class="portrait">
      <div class="plate" data-plate>
        <img
          src="/images/profile/portrait.webp"
          alt="Brandon van Vuuren"
          width="600"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="t-caption" data-rise>Brandon van Vuuren, Vanderbijlpark</figcaption>
    </figure>

    <div class="statement">
      <ScrollReveal client:visible={{ rootMargin: '800px' }} text={statement} className="t-statement" />
    </div>

    <ol class="chapters">
      {
        chapters.map((chapter, i) => (
          <li>
            <i data-rule></i>
            <div class="row" data-rise>
              <h3 class="mono chapter-title">
                <span class="chapter-no">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  {chapter.title}
                  {chapter.to && (
                    <>
                      {' '}
                      <span class="sr-only">to</span>
                      {' '}
                      <span class="nowrap">
                        <Arrow dir="right" />
                        {' '}
                        {chapter.to}
                      </span>
                    </>
                  )}
                </span>
              </h3>
              <p class="t-body">{chapter.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="stack">
      <i data-rule></i>
      <div class="row" data-rise>
        <p class="mono">Stack</p>
        <div>
          <p class="mono-data stack-list">
            {
              stack.map((name, i) => (
                <Fragment>
                  <span class="nowrap">
                    {name}
                    {i < stack.length - 1 && ' /'}
                  </span>
                  {i < stack.length - 1 && ' '}
                </Fragment>
              ))
            }
          </p>
          <p class="t-body cv">
            <a class="link" href={cv.href} target="_blank" rel="noopener">
              CV, PDF {cv.kb} KB<Arrow dir="down" />
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Phone: the portrait sits above the statement at 40 percent of the measure */
  .portrait {
    width: 40%;
    margin-bottom: clamp(2.5rem, 10vw, 4rem);
  }
  .portrait .plate {
    aspect-ratio: 3 / 4;
  }
  .portrait figcaption {
    margin-top: 0.75rem;
    color: var(--paper-2);
  }

  .chapters {
    margin-top: clamp(4rem, 8vw, 8rem);
  }
  .chapters > li > i,
  .stack > i {
    display: block;
    height: 1px;
    background: var(--rule);
  }

  .row {
    display: grid;
    row-gap: 0.75rem;
    padding-block: 1.5rem 2rem;
  }

  .chapter-title {
    display: flex;
    column-gap: 1.25em;
    color: var(--paper);
  }
  .chapter-no {
    flex: none;
    color: var(--paper-3);
  }

  .stack-list {
    max-width: 62ch;
    line-height: 1.7;
    color: var(--paper-2);
    text-wrap: pretty;
  }
  .nowrap {
    white-space: nowrap;
  }
  .cv {
    margin-top: 1.5rem;
  }

  @media (min-width: 900px) {
    .portrait {
      grid-column: 1 / 4;
      grid-row: 1 / span 3;
      width: 100%;
      margin-bottom: 0;
    }
    .statement,
    .chapters,
    .stack {
      grid-column: 4 / -1;
    }

    /* Nine equal columns spanning cols 4 to 12: title on cols 4-6, body on cols 7-12 */
    .row {
      grid-template-columns: repeat(9, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: baseline;
    }
    .row > :first-child {
      grid-column: 1 / 4;
    }
    .row > :last-child {
      grid-column: 4 / -1;
    }
  }
</style>
