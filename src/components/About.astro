---
import CvGameButton from './CvGameButton.astro';

/**
 * Portrait slot. Drop the real photo at this path when the asset folder lands;
 * until then the frame renders with the placeholder gradient behind it.
 */
const portrait = '/images/profile/portrait.webp';

const stack = [
  'react', 'nextdotjs', 'typescript', 'dotnet', 'cplusplus', 'python',
  'astro', 'nodedotjs', 'postgresql', 'docker', 'apachekafka', 'pytorch',
  'tailwindcss', 'redis', 'fastapi', 'git',
];

const chapters = [
  {
    year: 'Now',
    title: 'Full-stack & AI engineering',
    body: 'Building production systems end to end — modern frontends, scalable APIs, and models wired into features people actually press buttons on.',
  },
  {
    year: 'Platform',
    title: '.NET Framework 4 → .NET 8',
    body: 'Migrating legacy ASP.NET estates onto modern .NET with strict architecture standards: clear boundaries, testable seams, no rewrite-by-vibes.',
  },
  {
    year: 'Data',
    title: 'Streaming at 10k events/sec',
    body: 'Kafka pipelines feeding real-time dashboards, with anomaly detection and alerting that holds up under load rather than in a demo.',
  },
  {
    year: 'AI',
    title: 'Fine-tuning that pays for itself',
    body: 'LoRA/QLoRA pipelines with automated evaluation — 60% lower training cost, measured, not claimed.',
  },
];
---

<section id="about" class="about">
  <div class="shell about-grid">
    <!-- Portrait column: pinned, drifting, framed -->
    <div class="about-portrait-col">
      <figure class="portrait reveal-blur glow">
        <img
          src={portrait}
          alt="Brandon van Vuuren"
          loading="lazy"
          decoding="async"
          onerror="this.closest('.portrait').dataset.empty=''"
        />
        <figcaption>
          <strong>Brandon van Vuuren</strong>
          <span>Gqeberha, South&nbsp;Africa</span>
        </figcaption>
      </figure>

      <div class="portrait-badges" aria-hidden="true">
        <span class="badge scroll-parallax" style="--depth:34px">Ships to prod</span>
        <span class="badge scroll-parallax" style="--depth:-28px">Reads the stack trace</span>
      </div>
    </div>

    <!-- Copy column -->
    <div class="about-copy">
      <p class="t-eyebrow reveal">About</p>
      <h2 class="t-headline t-shine reveal" style="--d:80ms">
        Engineer first.<br />Everything else after.
      </h2>

      <p class="t-lede reveal" style="--d:160ms">
        I build systems that survive contact with real users, real data and real
        deadlines.
      </p>

      <p class="t-body reveal" style="--d:220ms">
        I work across React, Next.js, Node, Python, C# and C++, with a deep seam in
        ASP.NET migration and a working practice in applied AI. The common thread
        is maintainability: clear boundaries, honest error handling, and code the
        next person can read at 3am without a guide.
      </p>

      <ol class="chapters">
        {
          chapters.map((c, i) => (
            <li class="chapter reveal" style={`--d:${260 + i * 90}ms`}>
              <span class="chapter-year">{c.year}</span>
              <div>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="about-cta reveal">
        <CvGameButton size="md" />
        <a class="link-arrow" href="/assets/CV Brandon van Vuuren.pdf" target="_blank" rel="noopener">
          Download the CV
        </a>
      </div>
    </div>
  </div>

  <!-- Infinite stack marquee: two identical halves, CSS shifts by -50% -->
  <div class="strip" aria-label="Technology stack">
    <div class="marquee" style="--speed:48s">
      {
        [...stack, ...stack].map((s) => (
          <span class="chip">
            <img src={`https://cdn.simpleicons.org/${s}/8e8e93`} alt="" width="18" height="18" loading="lazy" />
            {s}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(5rem, 12vw, 9rem) 0;
    border-top: 1px solid var(--hairline);
  }

  .about-grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: start;
  }

  .about-portrait-col {
    position: relative;
  }

  .portrait {
    position: relative;
    margin: 0;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    /* Placeholder shows through if the portrait file isn't there yet */
    background:
      radial-gradient(70% 60% at 50% 20%, rgba(41, 151, 255, 0.35), transparent 70%),
      linear-gradient(180deg, #1b1b1f, #0b0b0d);
    aspect-ratio: 4 / 5;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .portrait[data-empty] img {
    display: none;
  }
  .portrait[data-empty]::after {
    content: 'portrait.webp';
    position: absolute;
    inset: auto 0 45%;
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }

  .portrait figcaption {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.15rem;
    padding: 3.5rem 1.25rem 1.25rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
  }
  .portrait figcaption strong {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .portrait figcaption span {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .portrait-badges {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .badge {
    position: absolute;
    padding: 0.45rem 0.85rem;
    border-radius: 980px;
    font-size: 0.75rem;
    font-weight: 550;
    color: var(--text);
    background: rgba(20, 20, 22, 0.82);
    border: 1px solid var(--hairline-strong);
    backdrop-filter: blur(12px);
    white-space: nowrap;
  }
  .badge:first-child {
    top: 12%;
    right: -6%;
  }
  .badge:last-child {
    bottom: 18%;
    left: -8%;
  }

  .about-copy {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }
  .about-copy h2,
  .about-copy p {
    margin: 0;
  }
  .about-copy > p {
    max-width: 56ch;
  }

  .chapters {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .chapter {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--hairline);
  }
  .chapter:last-child {
    border-bottom: 1px solid var(--hairline);
  }
  .chapter-year {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    padding-top: 0.2rem;
  }
  .chapter h3 {
    margin: 0 0 0.3rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .chapter p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 52ch;
  }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .strip {
    margin-top: clamp(4rem, 9vw, 7rem);
    padding-block: 1.5rem;
    border-block: 1px solid var(--hairline);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-dim);
    text-transform: capitalize;
    white-space: nowrap;
  }
  .chip img {
    opacity: 0.8;
  }

  @media (min-width: 950px) {
    .about-grid {
      grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
    }
    .about-portrait-col {
      position: sticky;
      top: 6rem;
    }
  }
</style>
