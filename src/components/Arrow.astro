---
interface Props {
  dir: 'right' | 'up-right' | 'down' | 'up';
}

const { dir } = Astro.props;

const paths = {
  right: 'M1 6h10M7 2l4 4-4 4',
  'up-right': 'M2 10L10 2M4 2h6v6',
  down: 'M6 1v10M2 7l4 4 4-4',
  up: 'M6 11V1M2 5l4-4 4 4',
};
---

<svg
  class="arrow"
  width="12"
  height="12"
  viewBox="0 0 12 12"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
>
  <path d={paths[dir]}></path>
</svg>
