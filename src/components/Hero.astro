---
import CvGameButton from './CvGameButton.astro';

/**
 * Floating screenshots. Swap `src` for the new asset folder when it lands —
 * `depth` is the parallax travel in px, `pos` places it on the desktop canvas.
 */
const floaters = [
  { src: '/images/Proof of Work/kafka-streaming-dashboard/home dash.webp', alt: 'Streaming analytics dashboard', depth: 120, pos: 'left: 2%;  top: 18%;  width: 20vw; max-width: 270px;', delay: 220 },
  { src: '/images/Proof of Work/Recode/analytics.png',                     alt: 'Recode analytics screen',      depth: 70,  pos: 'right: 3%; top: 14%;  width: 17vw; max-width: 235px;', delay: 340 },
  { src: '/images/Proof of Work/ai-invoice-manager/home.webp',             alt: 'AI invoice manager',           depth: 110, pos: 'left: 8%;  bottom: 6%; width: 15vw; max-width: 205px;', delay: 460 },
  { src: '/images/Proof of Work/nail-salon-website 2/home.webp',           alt: 'Salon booking platform',       depth: 40,  pos: 'right: 7%; bottom: 9%; width: 14vw; max-width: 190px;', delay: 560 },
];
---

<section id="top" class="hero">
  <div class="hero-aurora" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>

  <!-- Depth layer: screenshots drifting behind the headline -->
  <div class="hero-floaters" aria-hidden="true">
    {
      floaters.map((f) => (
        <figure class="floater reveal-blur scroll-parallax" style={`${f.pos} --depth:${f.depth}px; --d:${f.delay}ms;`}>
          <img src={f.src} alt={f.alt} loading="eager" decoding="async" />
        </figure>
      ))
    }
  </div>

  <div class="hero-body shell scroll-recede">
    <p class="t-eyebrow reveal">Full-stack engineer &middot; AI &middot; South Africa</p>

    <h1 class="t-display t-shine reveal-words reveal-depth">Brandon van Vuuren</h1>

    <p class="t-lede hero-lede reveal" style="--d:520ms">
      I build systems that ship. React and .NET on the front, Python and AI on the
      inside. Running in production, not in a slide deck.
    </p>

    <div class="hero-actions reveal" style="--d:640ms">
      <CvGameButton />
      <a class="btn btn-ghost" href="/assets/CV Brandon van Vuuren.pdf" target="_blank" rel="noopener">
        Read the PDF instead
      </a>
    </div>

    <dl class="hero-stats reveal" style="--d:760ms">
      <div><dt>5+</dt><dd>Years shipping</dd></div>
      <div><dt>25+</dt><dd>Projects delivered</dd></div>
      <div><dt>10k/s</dt><dd>Events streamed</dd></div>
    </dl>
  </div>

  <a class="hero-scroll" href="#work" aria-label="Scroll to work">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: 7rem 5rem;
    overflow: hidden;
    isolation: isolate;
  }

  /* Slow-breathing blue aurora, Apple's Pro-page background trick */
  .hero-aurora {
    position: absolute;
    inset: -30% -10% auto;
    height: 120%;
    z-index: -3;
    background:
      radial-gradient(45% 40% at 22% 28%, rgba(41, 151, 255, 0.28), transparent 70%),
      radial-gradient(40% 38% at 78% 22%, rgba(120, 80, 255, 0.2), transparent 72%),
      radial-gradient(55% 45% at 50% 82%, rgba(0, 200, 255, 0.14), transparent 72%);
    filter: blur(24px);
    animation: drift 22s var(--ease) infinite alternate;
  }
  @keyframes drift {
    to {
      transform: translate3d(0, -5%, 0) scale(1.12);
    }
  }

  /* Faint engineering grid, fading out towards the edges */
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 68px 68px;
    mask-image: radial-gradient(ellipse 75% 60% at 50% 42%, #000 20%, transparent 78%);
  }

  .hero-floaters {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: none;
  }

  .floater {
    position: absolute;
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    box-shadow: 0 30px 70px -28px rgba(0, 0, 0, 0.95);
    opacity: 0;
  }
  /* reveal-blur lands them at 0.55 rather than full: they are scenery, not content */
  .floater.is-in {
    opacity: 0.55;
  }
  .floater img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }

  .hero-body {
    position: relative;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1.4rem;
  }

  .hero-body h1 {
    margin: 0;
    max-width: 14ch;
  }

  .hero-lede {
    max-width: 44ch;
    margin: 0;
    text-wrap: balance;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.4rem;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    margin: 2.5rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--hairline);
    width: min(100%, 620px);
  }
  .hero-stats div {
    display: grid;
    gap: 0.2rem;
  }
  .hero-stats dt {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .hero-stats dd {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-dim);
    letter-spacing: -0.005em;
  }

  .hero-scroll {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    translate: -50% 0;
    width: 22px;
    height: 34px;
    border: 1px solid var(--hairline-strong);
    border-radius: 12px;
    display: grid;
    justify-items: center;
    padding-top: 6px;
  }
  .hero-scroll span {
    width: 2px;
    height: 6px;
    border-radius: 2px;
    background: var(--text-muted);
    animation: wheel 1.9s var(--ease) infinite;
  }
  @keyframes wheel {
    50% {
      transform: translateY(10px);
      opacity: 0.2;
    }
  }

  @media (min-width: 1100px) {
    .hero-floaters {
      display: block;
    }
  }
</style>
