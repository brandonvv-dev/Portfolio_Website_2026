---
import Arrow from './Arrow.astro';
import { sites } from '../data/sites';
import { counts, cv, year } from '../utils/site';

interface Props {
  hasSource: boolean;
}

const { hasSource } = Astro.props;

const plate = sites[0];

// One row per numbered section; the CSS counter renumbers itself exactly as the section counter does
const contents: { href: string; name: string; datum?: string }[] = [
  { href: '#work', name: 'Work', datum: `${counts.projects} projects` },
  { href: '#sites', name: 'Sites', datum: `${counts.sites} websites` },
  { href: '#ventures', name: 'Ventures', datum: 'Axiom' },
  { href: '#about', name: 'About' },
  { href: '#drive', name: 'Drive', datum: 'play the CV' },
  ...(hasSource ? [{ href: '#open-source', name: 'Source' }] : []),
  { href: '#contact', name: 'Contact' },
];
---

<section id="top" class="hero">
  <div class="wrap">
    <div class="hero-mast mono">
      <p class="hero-cell"><span data-load>Portfolio {year}</span></p>
      <p class="hero-cell hero-cell--place"><span data-load>Vanderbijlpark, South Africa</span></p>
      <p class="hero-cell hero-cell--role"><span data-load>Full-stack engineer &middot; AI</span></p>
      <i class="hero-rule" data-load></i>
    </div>

    <h1 class="t-cover" data-load>
      <span class="ln-mask"><span class="ln">Brandon</span></span>
      <span class="ln-mask"><span class="ln">van Vuuren</span></span>
    </h1>

    <nav class="hero-toc" aria-label="Contents">
      <p class="hero-toc-label mono"><span data-load>Contents</span></p>
      <ol role="list">
        {
          contents.map((row) => (
            <li>
              <i data-load />
              <a href={row.href}>
                <span class="hero-row" data-load>
                  <span class="hero-no mono-data" />
                  <span class="hero-name">{row.name}</span>
                  <span class="hero-leader" aria-hidden="true" />
                  {row.datum && <span class="hero-datum mono-data">{row.datum}</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="hero-lede">
      <p class="t-standfirst" data-load>
        Full-stack and AI engineer in Vanderbijlpark, South Africa. I build and migrate production software, from ASP.NET Framework to .NET 8, through streaming back ends and applied AI. <span class="hero-keep">{counts.projects} projects</span> and <span class="hero-keep">{counts.sites} client</span> websites follow.
      </p>
      <p class="hero-cv">
        <a class="link" href={cv.href} target="_blank" rel="noopener" data-load>
          CV, PDF {cv.kb} KB<Arrow dir="down" />
        </a>
      </p>
    </div>

    <figure class="hero-fig">
      <div class="plate" data-load>
        <img
          src={plate.card}
          width="900"
          height="563"
          loading="eager"
          decoding="async"
          alt={`${plate.name} website`}
        />
      </div>
      <figcaption class="t-caption" data-load>Plate 1. {plate.name}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(5.5rem, 7vw, 7rem);
    padding-bottom: clamp(5rem, 9vw, 9rem);
  }

  /* ---- Row A: masthead ---- */
  .hero-mast {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: var(--gap);
    margin-bottom: 1.5rem;
  }
  .hero-cell {
    margin: 0;
    overflow: clip;
  }
  .hero-cell > span {
    display: block;
  }
  .hero-rule {
    flex-basis: 100%;
    height: 1px;
    margin-top: 0.75rem;
    background: var(--rule-strong);
  }

  /* ---- Row B: the cover ---- */
  /* display is left alone on purpose: site.css makes a parent of .ln-mask a flex column */
  .hero h1 {
    margin: 0 0 2rem;
  }

  .hero-toc {
    margin-bottom: 2.5rem;
  }
  .hero-toc-label {
    margin: 0 0 0.5rem;
    overflow: clip;
  }
  .hero-toc-label > span {
    display: block;
  }
  .hero-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
  }
  .hero-toc li {
    position: relative;
    counter-increment: toc;
  }
  .hero-toc li > i {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--rule);
  }
  .hero-toc a {
    display: block;
    overflow: clip;
  }
  .hero-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 0.8125rem;
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  .hero-no::before {
    content: counter(toc, decimal-leading-zero);
  }
  .hero-leader {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted var(--rule-strong);
  }
  .hero-no,
  .hero-datum {
    transition: color 0.3s;
  }
  @media (hover: hover) {
    .hero-toc a:hover :is(.hero-no, .hero-datum) {
      color: var(--paper);
    }
  }
  .hero-toc a:focus-visible :is(.hero-no, .hero-datum) {
    color: var(--paper);
  }

  /* ---- Row C ---- */
  .hero-lede {
    margin-bottom: 2.5rem;
  }
  .hero-cv {
    margin: 1.75rem 0 0;
    font-size: 1.125rem;
  }

  .hero-fig {
    margin: 0;
    max-width: 34rem;
  }
  .hero-fig .plate {
    aspect-ratio: 900 / 563;
  }
  .hero-fig figcaption {
    margin-top: 0.75rem;
    color: var(--paper-2);
  }

  .hero-keep {
    white-space: nowrap;
  }

  /* Phones: the masthead sets two mono lines, role beside the issue, place below */
  @media (max-width: 899px) {
    .hero-cell--role {
      order: 2;
    }
    .hero-cell--place {
      order: 3;
      flex-basis: 100%;
    }
    .hero-rule {
      order: 4;
    }
  }

  /* Tablet and laptop: masthead on three columns, contents on two, standfirst and plate side by side */
  @media (min-width: 900px) {
    .hero-mast {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      margin-bottom: 2rem;
    }
    .hero-cell {
      grid-column: span 4;
    }
    .hero-cell--role {
      text-align: right;
    }
    .hero-rule {
      grid-column: 1 / -1;
    }
    .hero h1,
    .hero-toc {
      grid-column: 1 / -1;
    }
    .hero-toc ol {
      display: grid;
      grid-template-rows: repeat(4, auto);
      grid-auto-flow: column;
      column-gap: var(--gap);
    }
    .hero-lede {
      grid-column: 1 / span 6;
      margin: 0;
    }
    .hero-fig {
      grid-column: 7 / -1;
      max-width: none;
    }
  }

  /* The cover. Contents sit beside line one only: 'van Vuuren' is wider than cols 1-8 and its last
     letter stands just under the list, so the row pitch is tied to the type size and the list rises
     to the cap height of line one. The last row ends 24px or more above the ink of that letter at
     every width from 1500px. Below 1500px the pitch would fall under the 1.3 line box, so the list
     stays under the name instead. */
  @media (min-width: 1500px) {
    .hero h1 {
      grid-area: 2 / 1 / 3 / -1;
      margin-bottom: 3rem;
    }
    .hero-toc {
      grid-area: 2 / 9 / 3 / -1;
      align-self: start;
      position: relative;
      z-index: 2;
      margin: calc(var(--t-cover) * -0.058) 0 0;
    }
    .hero-toc ol {
      display: block;
    }
    .hero-row {
      font-size: 1.0625rem;
      padding-block: calc((var(--t-cover) * 0.13 - 6px - 1.3em) / 2);
    }
    .hero-lede {
      grid-area: 3 / 1 / 4 / 6;
    }
    .hero-fig {
      grid-area: 3 / 9 / 4 / -1;
    }
  }
</style>
