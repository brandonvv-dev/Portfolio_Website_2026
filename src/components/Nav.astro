---
import { counts, cv, email } from '../utils/site';

interface Props {
  /** Source is a section only when GitHub returned repositories. */
  hasSource: boolean;
}

const { hasSource } = Astro.props;

// The sheet lists the same sections as the bar, minus Drive, which is pinned below. Its numbers
// are written by nav.ts from the order of main > section[data-folio], so they match the page.
const index = [
  { id: 'work', label: 'Work' },
  { id: 'sites', label: 'Sites' },
  { id: 'ventures', label: 'Ventures' },
  { id: 'about', label: 'About' },
  ...(hasSource ? [{ id: 'open-source', label: 'Source' }] : []),
  { id: 'contact', label: 'Contact' },
];
---

<header class="nav" data-nav>
  <i class="nav-rule" data-load></i>
  <div class="nav-row">
    <a class="nav-mark" href="#top">Brandon van Vuuren</a>

    <p class="nav-here mono" data-nav-here aria-hidden="true"></p>

    <nav class="nav-links mono" aria-label="Sections">
      <a href="#work" data-section="work">Work</a>
      <a href="#sites" data-section="sites">Sites <span class="sup">{counts.sites}</span></a>
      <a href="#ventures" data-section="ventures">Ventures</a>
      <a href="#about" data-section="about">About</a>
      <a href="/drive" data-section="drive">Drive<span class="nav-sq" aria-hidden="true"></span></a>
      {hasSource && <a href="#open-source" data-section="open-source">Source</a>}
      <a href="#contact" data-section="contact">Contact</a>
      <a href={cv.href} target="_blank" rel="noopener">CV</a>
    </nav>

    <button
      class="nav-toggle mono"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-sheet"
    >
      Index
    </button>
  </div>
</header>

<div id="nav-sheet" class="sheet" data-nav-sheet role="dialog" aria-modal="true" aria-label="Index" hidden>
  <div class="sheet-top">
    <p class="mono">Index</p>
    <button class="nav-toggle mono" type="button" data-nav-close>Close</button>
  </div>

  <ol class="sheet-list">
    {
      index.map((item) => (
        <li>
          <a class="sheet-link" href={`#${item.id}`}>
            <span class="sheet-no mono" data-sheet-no={item.id}></span>
            <span class="sheet-name"><span class="ln-mask"><span class="ln">{item.label}</span></span></span>
          </a>
        </li>
      ))
    }
  </ol>

  <div class="sheet-foot mono">
    <a href="/drive">Drive<span class="nav-sq" aria-hidden="true"></span></a>
    <a href={cv.href} target="_blank" rel="noopener">CV</a>
    <a class="sheet-mail" href={`mailto:${email}`}>{email}</a>
  </div>
</div>

<style>
  /* ---- Bar ---- */
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: 48px;
    background: var(--ink-0);
  }
  /* The bottom border, drawn from the left at load */
  .nav-rule {
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--rule);
    transform-origin: left center;
  }
  .nav-row {
    display: flex;
    align-items: center;
    column-gap: var(--gap);
    height: 100%;
    width: min(100% - 2 * var(--gutter), var(--wrap-max));
    margin-inline: auto;
  }

  /* Links are shorter than the bar so the 2px ring at 3px offset fits inside it */
  .nav-mark {
    flex: none;
    margin-right: auto;
    padding-block: 6px;
    font-size: 17px;
    line-height: 24px;
    white-space: nowrap;
    color: var(--paper);
    text-decoration: none;
  }

  /* The running head: GSAP rolls spans stacked in one grid cell, so the row never changes height */
  .nav-here {
    display: none;
    flex: 1;
    overflow: clip;
    white-space: nowrap;
    color: var(--paper-2);
  }
  .nav-here :global(span) {
    grid-area: 1 / 1;
  }

  .nav-links {
    display: none;
    flex: none;
    align-items: center;
    column-gap: clamp(16px, 1.9vw, 28px);
  }
  .nav-links a {
    display: block;
    padding-block: 8px;
    color: var(--paper-2);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s;
  }
  .nav-links a:is(:hover, :focus-visible),
  .nav-links a[aria-current] {
    color: var(--paper);
  }
  .nav-links a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.5em;
    text-decoration-color: var(--rule-strong);
  }

  .nav-links .sup {
    margin-left: 0;
  }

  /* The state marker: static, the only colour in the bar */
  .nav-sq {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 0.7em;
    background: var(--accent);
    vertical-align: 0.1em;
  }

  .nav-toggle {
    flex: none;
    min-height: 44px;
    padding: 0 0 0 16px;
    border: 0;
    background: none;
    color: var(--paper);
    cursor: pointer;
  }
  /* A 44px target in a 48px bar leaves no room outside it for the ring */
  .nav-toggle:focus-visible {
    outline-offset: 0;
  }

  /* Without script the Index button would do nothing; the cover's contents list carries the links */
  @media (scripting: none) {
    .nav-toggle {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .nav-links {
      display: flex;
    }
    .nav-row > .nav-toggle {
      display: none;
    }
  }
  /* From 1100px the running head starts on the fifth column line, where the cover's masthead starts */
  @media (min-width: 1100px) {
    .nav-mark {
      width: calc(100% / 3 - var(--gap) * 2 / 3);
      margin-right: 0;
    }
    .nav-here {
      display: grid;
    }
  }

  /* ---- Sheet (under 900px) ---- */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    padding: 0 var(--gutter) max(1.5rem, env(safe-area-inset-bottom));
    background: var(--ink-0);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .sheet[hidden] {
    display: none;
  }
  @media (min-width: 900px) {
    .sheet {
      display: none;
    }
  }

  .sheet-top {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    border-bottom: 1px solid var(--rule);
  }

  .sheet-list {
    margin: 0;
    padding: 1rem 0 0;
    list-style: none;
  }
  .sheet-link {
    display: flex;
    align-items: baseline;
    column-gap: 1rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--rule);
    color: var(--paper);
    text-decoration: none;
  }
  .sheet-link:is(:hover, :focus-visible) {
    background: var(--ink-2);
  }
  .sheet-no {
    flex: none;
    min-width: 2.25rem;
  }
  .sheet-name {
    font-family: var(--serif-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 12vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .sheet-foot {
    display: grid;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
  }
  .sheet-foot a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--paper);
    text-decoration: none;
  }
  .sheet-foot .sheet-mail {
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--paper-2);
  }
</style>
