---
import Arrow from './Arrow.astro';
import Folio from './Folio.astro';
import { moreSiteCategories, moreSites } from '../data/more-sites';
import { siteLinks } from '../data/site-links';
import { sites } from '../data/sites';
import { counts, email, host } from '../utils/site';

const slugify = (text: string): string => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const groups = moreSiteCategories.map((category) => ({
  category,
  slug: slugify(category),
  list: moreSites.filter((site) => site.category === category),
}));

// From 900px the groups sit in three columns. Each group, longest first, joins the shortest column,
// so the columns end together. A group weighs its names plus the three rows its heading and bottom padding take.
const columns: { weight: number; groups: typeof groups }[] = Array.from({ length: 3 }, () => ({ weight: 0, groups: [] }));
for (const group of [...groups].sort((a, b) => b.list.length - a.list.length)) {
  const shortest = columns.reduce((a, b) => (b.weight < a.weight ? b : a));
  shortest.groups.push(group);
  shortest.weight += group.list.length + 3;
}
---

<section id="sites" class="sec" data-folio="Sites">
  <div class="wrap opener">
    <Folio name="Sites" datum={`${counts.sites} websites`} />
    <h2 class="t-number sites-num" aria-label={`${counts.sites} client websites`}>
      <span aria-hidden="true" data-count={counts.sites}>{counts.sites}</span>
    </h2>
    <p class="t-body sites-deck" data-split>
      Client websites for barbers, salons, dentists, mechanics, butchers and other small businesses, all live.
      {counts.shown} have full galleries below; the other {counts.listed} are in the index at the end.
    </p>
  </div>

  <ul class="wrap plates">
    {
      sites.map((site) => {
        const link = siteLinks[site.slug];
        return (
          <li id={`site-${site.slug}`}>
            <button
              class="plate-btn"
              type="button"
              data-site={site.slug}
              data-name={site.name}
              data-images={JSON.stringify(site.images)}
              data-url={link ?? ''}
            >
              <span class="plate" data-plate>
                <img
                  src={site.card}
                  alt={`${site.name} website`}
                  width="900"
                  height="563"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="cap">
                <span class="mono">Pl. {String(site.num).padStart(2, '0')}</span>
                <span class="cap-text">
                  <span class="cap-name">{site.name}</span>
                  {link && <span class="mono-data cap-host">{host(link)}</span>}
                </span>
              </span>
            </button>
          </li>
        );
      })
    }
  </ul>

  <div class="wrap idx">
    <Folio numbered={false} name="Index" datum={`${counts.listed} more`} />

    <div class="idx-bar" aria-hidden="true" data-load>
      <i style={`flex-grow:${counts.shown}`}></i>
      {groups.map((group) => <i style={`flex-grow:${group.list.length}`}></i>)}
    </div>

    <ul class="idx-legend mono-data">
      <li class="idx-key">Galleries <span>{counts.shown}</span></li>
      {
        groups.map((group) => (
          <li>
            <a class="link" href={`#idx-${group.slug}`}>{group.category}</a> <span>{group.list.length}</span>
          </li>
        ))
      }
    </ul>

    <div class="idx-groups">
      {
        columns.map((column) => (
          <div class="idx-col">
            {column.groups.map((group) => (
              <div class="idx-group" id={`idx-${group.slug}`} data-rise>
                <h3 class="idx-h">
                  <button
                    class="mono idx-btn"
                    type="button"
                    disabled
                    aria-expanded="true"
                    aria-controls={`idx-panel-${group.slug}`}
                  >
                    <span>{group.category}</span>
                    <span class="idx-n">{group.list.length}</span>
                    <span class="idx-mark" aria-hidden="true" />
                  </button>
                </h3>
                <ul class="idx-panel" id={`idx-panel-${group.slug}`}>
                  {
                    group.list.map((site) => (
                      <li>
                        <a href={site.url} target="_blank" rel="noopener">
                          {site.name.split(' ').slice(0, -1).join(' ')}{' '}
                          <span class="idx-last">{site.name.split(' ').at(-1)}<Arrow dir="up-right" /></span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<dialog class="lightbox" data-lightbox aria-labelledby="lb-title">
  <header>
    <div class="lb-head">
      <h3 id="lb-title" data-lb-title></h3>
      <p class="mono" data-lb-count></p>
    </div>
    <a class="lb-live mono" data-lb-live target="_blank" rel="noopener" hidden>View website<Arrow dir="up-right" /></a>
    <button class="lb-close mono" type="button" data-lb-close>Close</button>
  </header>

  <!-- Vertical, page after page: reads like scrolling the site itself -->
  <div class="pages" data-lb-pages></div>

  <footer class="mono">
    <span>Built by <a class="link" href="https://axiom-billing.vercel.app/" target="_blank" rel="noopener">Axiom</a></span>
    <a class="link" data-lb-foot-live target="_blank" rel="noopener" hidden>View website<Arrow dir="up-right" /></a>
    <a class="link" href={`mailto:${email}`}>Want one like this?<Arrow dir="right" /></a>
  </footer>
</dialog>

<style>
  /* ---- Opener: the number is the headline ---- */
  .opener {
    margin-bottom: clamp(4rem, 9vw, 9rem);
  }
  .sites-num {
    margin: 0;
    color: var(--paper);
    white-space: nowrap;
  }
  .sites-deck {
    margin: 2rem 0 0;
    color: var(--paper-2);
  }

  /* ---- Plates ---- */
  .plates {
    row-gap: 2.5rem;
    column-gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .plates > li {
    grid-column: auto;
    min-width: 0;
  }
  .plate-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--paper);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .plates .plate {
    aspect-ratio: 4 / 5;
  }
  .plates .plate :global(img) {
    object-position: 50% 0;
  }

  .cap {
    display: grid;
    gap: 0.25rem 1rem;
    padding-top: 0.875rem;
  }
  .cap-text {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }
  .cap-name {
    position: relative;
    display: block;
    width: fit-content;
    max-width: 100%;
    font-family: var(--serif);
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  /* The caption underline draws left to right; CSS owns it, GSAP never touches this node */
  .cap-name::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.2rem;
    height: 1px;
    background: var(--paper);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .plate-btn:is(:hover, :focus-visible) .cap-name::after {
    transform: scaleX(1);
  }
  .cap-host {
    overflow-wrap: anywhere;
  }

  @media (min-width: 900px) {
    .opener .sites-num {
      grid-column: 1 / span 7;
      align-self: last baseline;
    }
    .opener .sites-deck {
      grid-column: 8 / span 5;
      align-self: last baseline;
      margin: 0;
    }

    .plates {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      row-gap: 6rem;
      align-items: start;
    }
    .plates .plate {
      aspect-ratio: 16 / 10;
    }
    .cap {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }

    /* Blocks of five on the 12-column grid: 6 | 3 | 3 over 4 | 8 */
    .plates > li:nth-child(5n + 1) {
      grid-column: 1 / span 6;
    }
    .plates > li:nth-child(5n + 2) {
      grid-column: span 3;
      margin-top: 6rem;
    }
    .plates > li:nth-child(5n + 3) {
      grid-column: span 3;
    }
    .plates > li:nth-child(5n + 4) {
      grid-column: 1 / span 4;
      margin-top: 3rem;
    }
    .plates > li:nth-child(5n + 5) {
      grid-column: span 8;
    }
    .plates > li:is(:nth-child(5n + 2), :nth-child(5n + 3)) .plate {
      aspect-ratio: 4 / 5;
    }
  }

  /* ---- Index ---- */
  .idx {
    margin-top: clamp(6rem, 12vw, 12rem);
  }
  .idx-bar {
    grid-column: 1 / -1;
    display: flex;
    gap: 2px;
    height: 12px;
  }
  .idx-bar i {
    flex-basis: 0;
    min-width: 0;
    background: var(--paper-3);
  }
  .idx-bar i:first-child {
    background: var(--paper);
  }

  .idx-legend {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 1.25rem 0 clamp(3rem, 6vw, 5rem);
    padding: 0;
    list-style: none;
  }
  .idx-legend a {
    color: var(--paper-2);
  }
  .idx-key {
    color: var(--paper);
  }

  .idx-groups {
    grid-column: 1 / -1;
    border-bottom: 1px solid var(--rule-strong);
  }
  .idx-h {
    margin: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .idx-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1rem 0;
    border: 0;
    background: none;
    color: var(--paper);
    text-align: left;
    cursor: pointer;
  }
  .idx-btn:disabled {
    cursor: default;
  }
  .idx-n {
    margin-left: auto;
    color: var(--paper-3);
  }
  /* Plus that becomes a cross when open; two hairlines, so no icon is shipped */
  .idx-mark {
    position: relative;
    flex: none;
    width: 10px;
    height: 10px;
  }
  .idx-mark::before,
  .idx-mark::after {
    content: '';
    position: absolute;
    background: currentColor;
  }
  .idx-mark::before {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }
  .idx-mark::after {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    transition: transform 0.3s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .idx-btn[aria-expanded='true'] .idx-mark::after {
    transform: scaleY(0);
  }

  .idx-panel {
    margin: 0;
    padding: 0 0 1.5rem;
    list-style: none;
  }
  /* Hanging indent: a name that wraps never reads as two entries */
  .idx-panel li {
    padding-left: 1rem;
    text-indent: -1rem;
    font-family: var(--serif);
    font-size: 1.0625rem;
    line-height: 1.9;
    color: var(--paper-2);
  }
  .idx-panel a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: transparent;
    transition:
      color 0.3s,
      text-decoration-color 0.3s;
  }
  /* The arrow rides the last word: a lone arrow on its own line reads as an empty row. */
  .idx-last {
    white-space: nowrap;
  }
  .idx-panel a :global(.arrow) {
    width: 10px;
    height: 10px;
    margin-left: 0.5rem;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .idx-panel a:is(:hover, :focus-visible) {
    color: var(--paper);
    text-decoration-color: var(--accent);
  }
  .idx-panel a:is(:hover, :focus-visible) :global(.arrow) {
    opacity: 1;
  }

  /* Phone: a collapsed list per group. Without script the panels simply stay open. */
  @media (scripting: enabled) and (max-width: 899px) {
    .idx-group:not([data-open]) .idx-panel {
      display: none;
    }
  }
  @media (min-width: 900px) {
    .idx-groups {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      column-gap: var(--gap);
      border-bottom: 0;
    }
    .idx-mark {
      display: none;
    }
    .idx-panel {
      padding-bottom: 3rem;
    }
  }

  /* ---- Lightbox ---- */
  .lightbox {
    width: min(1040px, 94vw);
    height: min(92dvh, 1100px);
    max-width: none;
    max-height: 92dvh;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: 0;
    background: var(--ink-1);
    color: var(--paper);
    overflow: hidden;
  }
  /* A grid only while open, or [open] is fought by the dialog's own display: none */
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }
  .lightbox::backdrop {
    background: rgba(11, 10, 9, 0.88);
  }

  .lightbox header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .lb-head {
    margin-right: auto;
    min-width: 0;
  }
  .lightbox h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .lb-head p {
    margin: 0.25rem 0 0;
  }
  .lb-live,
  .lb-close {
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--rule-strong);
    background: none;
    color: var(--paper);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }
  .lb-live:is(:hover, :focus-visible),
  .lb-close:is(:hover, :focus-visible) {
    background: var(--ink-2);
    border-color: var(--paper-3);
  }
  .lb-live :global(.arrow) {
    margin-left: 0.5em;
  }
  .lightbox [hidden] {
    display: none;
  }

  /* Screens stacked top to bottom, so scrolling reads like the site itself */
  .pages {
    display: grid;
    gap: 0.75rem;
    padding: 0.75rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--ink-0);
    scrollbar-width: thin;
  }
  .pages :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    background: var(--ink-2);
  }

  .lightbox footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    padding: 0.875rem 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .lightbox footer > :last-child {
    margin-left: auto;
  }
</style>
