---
import Arrow from './Arrow.astro';
import Folio from './Folio.astro';
import FlowingMenu from './bits/FlowingMenu';
import type { MenuItemData } from './bits/FlowingMenu';
import { cv, email, year } from '../utils/site';

const rows: MenuItemData[] = [
  { text: 'Email', meta: email, link: `mailto:${email}` },
  { text: 'GitHub', meta: 'github.com/brandonvv-dev', link: 'https://github.com/brandonvv-dev', external: true },
  {
    text: 'LinkedIn',
    meta: 'linkedin.com/in/brandon-van-vuuren',
    link: 'https://www.linkedin.com/in/brandon-van-vuuren-9616841b6',
    external: true,
  },
  { text: 'CV', meta: `PDF, ${cv.kb} KB`, link: cv.href, external: true },
];
---

<section id="contact" class="sec contact" data-folio="Contact">
  <Folio name="Contact" datum="Vanderbijlpark, ZA" />

  <div class="wrap">
    <h2 class="t-statement contact-head" data-split>Start a conversation.</h2>
    <p class="t-body contact-note" data-split>
      Based in Vanderbijlpark, South Africa. Email is the quickest way to start a project.
    </p>

    <div class="contact-menu">
      <FlowingMenu
        client:visible={{ rootMargin: '400px' }}
        items={rows}
        label="Contact channels"
        speed={22}
        textColor="var(--paper)"
        bgColor="transparent"
        marqueeBgColor="var(--accent)"
        marqueeTextColor="var(--ink-0)"
        borderColor="var(--rule)"
      />
    </div>
  </div>

  <footer class="wrap colophon">
    <p class="mono-data">
      Set in Newsreader and IBM Plex Mono. Built with Astro and GSAP. Grain, billboard wall, text reveal and contact
      menu adapted from React Bits.
    </p>
    <p class="mono-data colophon-mid">Brandon van Vuuren, Vanderbijlpark, South Africa</p>
    <div class="mono-data colophon-end">
      <p>&copy; {year}</p>
      <a class="link" href="#top">Back to top <Arrow dir="up" /></a>
    </div>
  </footer>
</section>

<style>
  .sec.contact {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .contact-note {
    margin: 1.5rem 0 0;
    color: var(--paper-2);
    text-wrap: balance;
  }
  .contact-head {
    margin: 0;
  }

  /* The box is sized before the island hydrates, so nothing moves when it does */
  .contact-menu {
    --row-h: 96px;
    height: calc(4 * var(--row-h));
    margin-top: clamp(3rem, 6vw, 6rem);
  }

  .colophon {
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    row-gap: 1rem;
  }
  .colophon p {
    margin: 0;
  }
  .colophon-end {
    display: grid;
    row-gap: 0.5rem;
    justify-items: start;
  }
  .colophon-end .link {
    color: var(--paper);
  }

  @media (min-width: 600px) {
    .contact-menu {
      --row-h: clamp(88px, 17vh, 168px);
    }
  }

  @media (min-width: 900px) {
    .contact-head,
    .contact-note {
      grid-column: 1 / 6;
    }
    .contact-menu {
      grid-column: 1 / -1;
    }

    .colophon > :nth-child(1) {
      grid-column: 1 / 5;
    }
    .colophon-mid {
      grid-column: 5 / 9;
      text-align: center;
    }
    .colophon-end {
      grid-column: 9 / 13;
      justify-items: end;
      text-align: right;
    }
  }
</style>
