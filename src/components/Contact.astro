---
import CvGameButton from './CvGameButton.astro';

const email = 'brandon.vanvuuren60@gmail.com';

const channels = [
  { label: 'Email', value: email, href: `mailto:${email}` },
  { label: 'GitHub', value: 'brandonvv-dev', href: 'https://github.com/brandonvv-dev' },
  { label: 'LinkedIn', value: 'brandon-van-vuuren', href: 'https://www.linkedin.com/in/brandon-van-vuuren-9616841b6' },
];
---

<section id="contact" class="contact">
  <div class="shell contact-inner">
    <p class="t-eyebrow reveal">Contact</p>

    <h2 class="t-headline t-shine reveal" style="--d:80ms">
      Got something that<br />needs building?
    </h2>

    <p class="t-lede contact-lede reveal" style="--d:160ms">
      Fast turnaround, clean code, and a straight answer about what it&rsquo;ll take.
    </p>

    <div class="contact-actions reveal" style="--d:240ms">
      <a class="btn btn-primary" href={`mailto:${email}`}>Start a conversation</a>
      <CvGameButton size="md" />
    </div>

    <ul class="channels">
      {
        channels.map((c, i) => (
          <li class="reveal" style={`--d:${300 + i * 80}ms`}>
            <a href={c.href} target={c.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener">
              <span class="channel-label">{c.label}</span>
              <span class="channel-value">{c.value}</span>
              <span class="channel-arrow" aria-hidden="true">›</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <footer class="foot">
    <div class="shell foot-inner">
      <p>© {new Date().getFullYear()} Brandon van Vuuren</p>
      <p><a href="/drive">Drive the CV</a> · <a href="/assets/CV Brandon van Vuuren.pdf" target="_blank" rel="noopener">PDF version</a></p>
    </div>
  </footer>
</section>

<style>
  .contact {
    border-top: 1px solid var(--hairline);
    background:
      radial-gradient(60% 60% at 50% 0%, rgba(41, 151, 255, 0.14), transparent 70%),
      var(--bg);
  }

  .contact-inner {
    padding-block: clamp(5rem, 12vw, 9rem) clamp(4rem, 8vw, 6rem);
    display: grid;
    gap: 1.1rem;
    justify-items: center;
    text-align: center;
  }
  .contact-inner h2 {
    margin: 0;
  }
  .contact-lede {
    margin: 0;
    max-width: 46ch;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.75rem;
  }

  .channels {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    width: min(100%, 620px);
    text-align: left;
  }
  .channels li:first-child a {
    border-top: 1px solid var(--hairline);
  }
  .channels a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 0.25rem;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    color: var(--text);
    transition: padding-inline 0.3s var(--ease), color 0.3s var(--ease);
  }
  .channels a:hover {
    padding-inline: 0.75rem 0;
    color: var(--accent);
  }
  .channel-label {
    font-size: 0.8125rem;
    color: var(--text-dim);
    width: 5.5rem;
    flex: 0 0 auto;
  }
  .channel-value {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.012em;
    word-break: break-all;
  }
  .channel-arrow {
    margin-left: auto;
    color: var(--text-dim);
    font-size: 1.25rem;
  }

  .foot {
    border-top: 1px solid var(--hairline);
    padding-block: 1.75rem;
  }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .foot-inner p {
    margin: 0;
  }
  .foot-inner a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .foot-inner a:hover {
    color: var(--accent);
  }
</style>
