---
/** The headline act: "View CV" rendered as a playable thing. */
interface Props {
  size?: 'lg' | 'md';
  class?: string;
}
const { size = 'lg', class: cls = '' } = Astro.props;
---

<a href="/drive" class={`cv-game cv-game--${size} ${cls}`} data-tilt="5">
  <span class="cv-game-road" aria-hidden="true"></span>

  <span class="cv-game-car" aria-hidden="true">
    <svg viewBox="0 0 32 18" width="30" height="17" fill="none">
      <path
        d="M2 12.5h28M4.5 12.5 6.8 6.2A3 3 0 0 1 9.6 4.2h12.8a3 3 0 0 1 2.6 1.5l3.6 6.8"
        stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
      />
      <circle cx="9" cy="13.4" r="2.6" fill="currentColor" />
      <circle cx="23" cy="13.4" r="2.6" fill="currentColor" />
    </svg>
  </span>

  <span class="cv-game-text">
    <strong>View CV</strong>
    <small>Drive it &mdash; it&rsquo;s a game</small>
  </span>

  <span class="cv-game-keys" aria-hidden="true">
    <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd>
  </span>
</a>

<style>
  .cv-game {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 1.1rem 0.7rem 0.9rem;
    border-radius: 980px;
    text-decoration: none;
    color: var(--text);
    background: linear-gradient(180deg, #1c1c1e, #0e0e10);
    border: 1px solid var(--hairline-strong);
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.4s var(--ease-out), border-color 0.3s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .cv-game:hover {
    border-color: var(--accent);
    box-shadow: 0 10px 40px -12px rgba(41, 151, 255, 0.55);
  }

  /* Tarmac stripes that only start moving on hover. */
  .cv-game-road {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    z-index: -1;
    background: repeating-linear-gradient(
      90deg,
      var(--accent) 0 14px,
      transparent 14px 30px
    );
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .cv-game:hover .cv-game-road {
    opacity: 0.85;
    animation: road 0.6s linear infinite;
  }
  @keyframes road {
    to {
      background-position-x: -30px;
    }
  }

  .cv-game-car {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: rgba(41, 151, 255, 0.14);
    color: var(--accent-hi);
    transition: transform 0.45s var(--ease-out), background 0.3s var(--ease);
  }
  .cv-game:hover .cv-game-car {
    background: var(--accent);
    color: #fff;
    transform: translateX(3px);
  }

  .cv-game-text {
    display: grid;
    line-height: 1.15;
    text-align: left;
  }
  .cv-game-text strong {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.012em;
  }
  .cv-game-text small {
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: -0.004em;
  }

  .cv-game-keys {
    display: none;
    gap: 3px;
    margin-left: 0.35rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--hairline);
  }
  .cv-game-keys kbd {
    font: inherit;
    font-size: 0.625rem;
    font-weight: 600;
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border-radius: 4px;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--hairline);
  }
  .cv-game:hover .cv-game-keys kbd {
    color: var(--text);
    border-color: var(--hairline-strong);
  }

  .cv-game--lg {
    padding: 0.8rem 1.35rem 0.8rem 1rem;
  }

  @media (min-width: 560px) {
    .cv-game--lg .cv-game-keys {
      display: flex;
    }
  }
</style>
