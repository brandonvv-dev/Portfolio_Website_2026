---
/** The one solid button on the page: the way into the game. */
---

<a class="cv-game" href="/drive">
  <span class="cv-game-label">Take it for a drive</span>
  <span class="cv-game-keys" aria-hidden="true">
    <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd>
  </span>
</a>

<style>
  .cv-game {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    height: 56px;
    padding-inline: 20px;
    background: var(--paper);
    color: var(--ink-0);
    text-decoration: none;
    transition: background-color 0.25s;
  }
  .cv-game:is(:hover, :focus-visible) {
    background: var(--accent);
  }

  .cv-game-label {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1;
  }

  .cv-game-keys {
    display: flex;
    gap: 4px;
  }
  .cv-game-keys kbd {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    width: 24px;
    height: 24px;
    border: 1px solid var(--ink-0);
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.09em;
    /* the trailing tracking would push the glyph off centre */
    padding-left: 0.09em;
  }
</style>