---
import CvGameButton from './CvGameButton.astro';
import Folio from './Folio.astro';
import GridMotion from './bits/GridMotion';
import { sites } from '../data/sites';
import { ventures } from '../data/ventures';

const drive = ventures.find((venture) => venture.id === 'drive');
if (!drive) throw new Error('ventures.ts has no entry with id "drive"');
---

<section id="drive" class="drive" data-folio="Drive">
  <div class="drive-wall" aria-hidden="true">
    <GridMotion
      client:visible={{ rootMargin: '400px' }}
      items={sites.map((site) => site.card)}
      rows={4}
      aspectRatio={1.6}
      gap={12}
      angle={-6}
      tilt={28}
      speed={16}
      parallax={0.4}
      spotlight={0.6}
      dim={0.7}
      grayscale
      fade={0.2}
    />
  </div>

  <div class="wrap">
    <div class="drive-card" data-plate>
      <Folio name="Drive" datum="three.js · Rapier" />
      <h2 class="t-feature" data-split>Don't read my CV. Drive through it.</h2>
      <p class="t-body drive-blurb">{drive.blurb}</p>
      <p class="mono-data drive-spec">three.js · Rapier · nothing loads until you click</p>
      <CvGameButton />
    </div>
  </div>
</section>

<style>
  /* The band is opaque ink-0 and covers the page grid. The wall is absolute, so hydrating it moves nothing. */
  .drive {
    position: relative;
    z-index: 2;
    display: grid;
    align-items: end;
    min-height: 92svh;
    padding-block: clamp(1.25rem, 5vw, 5rem);
    overflow: hidden;
    background: var(--ink-0);
  }
  .drive-wall {
    position: absolute;
    inset: 0;
  }
  .drive .wrap {
    position: relative;
  }

  .drive-card {
    grid-column: 1 / -1;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    background: var(--ink-1);
    border: 1px solid var(--rule);
  }
  @media (min-width: 900px) {
    .drive-card {
      grid-column: 1 / span 7;
    }
  }
  @media (min-width: 1100px) {
    .drive-card {
      grid-column: 1 / span 5;
    }
  }

  .drive-card :global(.folio) {
    width: auto;
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
  }
  .drive-blurb {
    margin: clamp(1.25rem, 2vw, 1.75rem) 0 0;
    color: var(--paper-2);
  }
  .drive-spec {
    margin: 1.5rem 0 2rem;
  }
</style>