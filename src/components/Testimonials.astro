---
import testimonials from '../data/testimonials';
---

<section id="testimonials" class="quotes">
  <div class="shell quotes-head">
    <p class="t-eyebrow reveal">Clients</p>
    <h2 class="t-headline t-shine reveal" style="--d:80ms">
      What it&rsquo;s like<br />on the other side.
    </h2>
  </div>

  <div class="rail quotes-rail">
    {
      testimonials.map((t, i) => (
        <figure class="quote card reveal" style={`--d:${i * 100}ms`}>
          <div class="quote-stars" aria-label={`${t.rating} out of 5`}>
            {Array.from({ length: 5 }, (_, n) => (
              <span class={n < Math.floor(t.rating) ? 'on' : n < t.rating ? 'half' : ''}>★</span>
            ))}
          </div>

          <blockquote>{t.content}</blockquote>

          <figcaption>
            <img src={t.avatar} alt="" width="40" height="40" loading="lazy" />
            <span>
              <strong>{t.name}</strong>
              <small>
                {t.role}, {t.company}
              </small>
            </span>
          </figcaption>

          <p class="quote-project">{t.project}</p>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .quotes {
    padding-block: clamp(5rem, 12vw, 9rem);
    border-top: 1px solid var(--hairline);
  }

  .quotes-head {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .quotes-head h2 {
    margin: 0.5rem 0 0;
  }

  .quotes-rail {
    /* Rail is edge-to-edge; the shell gutter keeps card 1 aligned with the heading */
    align-items: stretch;
  }

  .quote {
    display: grid;
    gap: 1rem;
    align-content: start;
    width: min(84vw, 400px);
    padding: 1.6rem;
    margin: 0;
    background: linear-gradient(180deg, #131315, #0b0b0d);
  }

  .quote-stars {
    display: flex;
    gap: 2px;
    font-size: 0.875rem;
    color: #3a3a3e;
  }
  .quote-stars .on,
  .quote-stars .half {
    color: #f5a623;
  }
  .quote-stars .half {
    opacity: 0.55;
  }

  .quote blockquote {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    letter-spacing: -0.008em;
    color: var(--text-muted);
  }

  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
  }
  .quote figcaption img {
    border-radius: 50%;
    background: var(--surface-2);
  }
  .quote figcaption span {
    display: grid;
  }
  .quote figcaption strong {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.012em;
  }
  .quote figcaption small {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .quote-project {
    margin: 0;
    font-size: 0.75rem;
    color: var(--accent);
  }
</style>
