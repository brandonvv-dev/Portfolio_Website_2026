---
import '../styles/global.css';
import '../styles/site.css';

interface Props {
  title?: string;
}

const { title = 'Back office' } = Astro.props;
const preloadedFonts = ['newsreader-display-300', 'newsreader-text-400', 'plex-mono-400'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b0a09" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadedFonts.map((font) => (
      <link rel="preload" href={`/fonts/${font}.woff2`} as="font" type="font/woff2" crossorigin />
    ))}

    <style is:inline>
      /* Paint the warm black before the stylesheet arrives, no white flash. */
      html { background: #0b0a09; }
      body { margin: 0; background: #0b0a09; color: #ebe5d6; }
    </style>

    <slot name="head" />
  </head>

  <body class="admin">
    <slot />
  </body>
</html>
