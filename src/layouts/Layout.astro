---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Chromeless pages (the game) skip the site nav and page padding. */
  bare?: boolean;
}

const {
  title = 'Brandon van Vuuren — Full-stack Developer & AI Engineer',
  description = 'Brandon van Vuuren builds production systems across React, .NET, Python and AI. Selected work, live repositories, and a CV you can drive through.',
  bare = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..800&display=swap"
    />

    <style is:inline>
      /* Paint black before anything else loads — no white flash. */
      html { background: #000; }
      body { margin: 0; background: #000; color: #f5f5f7; }
    </style>

    <slot name="head" />
  </head>

  <body class={bare ? 'is-bare' : ''}>
    <slot />
    {!bare && <script>import '../scripts/motion.ts';</script>}
  </body>
</html>
