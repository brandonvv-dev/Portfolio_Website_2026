---
import Layout from '../layouts/Layout.astro';
import { moreSites } from '../data/more-sites';
---

<Layout
  bare
  title="Drive my CV — Brandon van Vuuren"
  description="Brandon van Vuuren's CV as a drivable 3D world. WASD to drive, drive over a project to open it."
>
  <canvas data-canvas tabindex="0" aria-label="Drivable 3D portfolio"></canvas>

  <!-- Loading -->
  <div class="screen" data-loading>
    <p class="mono">Loading the world</p>
    <div class="bar"><i data-progress></i></div>
  </div>

  <!-- Intro: the world is already running behind it -->
  <div class="screen" data-intro hidden>
    <p class="mono">Brandon van Vuuren</p>
    <h1>Drive my CV.</h1>
    <p class="blurb">Twenty client sites stand along the street, and {moreSites.length} more are listed in the directory beside Axiom. Pull into a bay to open one, or hold W for the fast lane to the CV, and wreck whatever is in the way: it keeps score.</p>

    <ul class="keys">
      <li><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd><span>Drive</span></li>
      <li><kbd>Space</kbd><span>Brake</span></li>
      <li><kbd>Shift</kbd><span>Boost</span></li>
      <li><kbd>E</kbd><span>Open</span></li>
      <li><kbd>R</kbd><span>Reset</span></li>
      <li><kbd>H</kbd><span>Horn</span></li>
      <li><kbd>C</kbd><span>Camera</span></li>
      <li><kbd>M</kbd><span>Map</span></li>
    </ul>

    <button data-start class="start" type="button">Start driving</button>
    <button class="hud-btn" data-sound type="button" aria-pressed="true">Sound on</button>
    <a class="exit" href="/">Back to the normal site</a>
    <p class="credit">3D models by <a href="https://kenney.nl" target="_blank" rel="noopener">Kenney</a> (CC0)</p>
  </div>

  <!-- No WebGL 2, a load that failed, or a context that was lost -->
  <div class="screen" data-fallback hidden>
    <h1>The 3D version can&rsquo;t run right now.</h1>
    <p class="blurb">No problem: here&rsquo;s the same CV, flat.</p>
    <a class="start" href="/assets/CV Brandon van Vuuren.pdf" target="_blank" rel="noopener">Open the PDF</a>
    <!-- An empty href is this page, query included. -->
    <a class="exit" href="">Reload</a>
    <a class="exit" href="/">Back to the normal site</a>
  </div>

  <!-- In-game chrome. The map and the timed run append their own button and chip. -->
  <div class="hud" data-hud hidden>
    <a class="hud-btn" href="/">&lsaquo; Exit</a>
    <button class="hud-btn" data-reset type="button">Reset</button>
    <button class="hud-btn" data-sound type="button" aria-pressed="true">Sound on</button>
    <button class="hud-btn" data-camera type="button">Camera</button>
    <p class="hud-tip">WASD, Space brake, Shift boost, E open, C camera, M map</p>
    <div class="hud-stat"><b data-sites>0/20</b><span>sites</span></div>
    <div class="hud-stat"><b data-secrets>0/3</b><span>secrets</span></div>
    <div class="hud-stat" title="Props knocked over"><b data-score>0</b><span>hit</span></div>
    <div class="hud-stat"><b data-speed>0</b><span>km/h</span></div>
  </div>

  <!-- One article.panel per pad, and one .toast at a time: both are built by the game. -->
  <aside data-panel></aside>
  <div data-toasts role="status"></div>

  <!-- Touch only -->
  <button data-open type="button">Open</button>
  <div data-stick><span data-knob></span></div>
  <button data-brake type="button">Brake</button>
  <button data-boost type="button">Boost</button>

  <!-- Covers the jump of a reset and of a camera switch -->
  <div data-fade></div>

  {
    /* On a phone the dev toolbar's hit box lies over Brake, and a drive test on the dev server
       has to be able to brake. */
    import.meta.env.DEV && <style is:inline>astro-dev-toolbar { display: none; }</style>
  }

  <script>
    import '../game/main.ts';
  </script>
</Layout>

<style is:global>
  /*
   * One global block, on purpose. Astro scopes a plain style block to the elements that exist at
   * build time (.hud-btn compiles to .hud-btn[data-astro-cid-...]), and the game builds panels,
   * toasts, chips and buttons at run time: a scoped rule never reaches them. Only this page loads
   * this sheet, so nothing leaks.
   *
   * The classes other modules build from, without writing CSS of their own:
   *   .screen       a full-screen state
   *   .hud-btn      a button or a link, anywhere
   *   .hud-stat     a chip: a b for the number and a span for its unit
   *   .panel        an article inside [data-panel]: closed until it gets .is-active
   *   .toast        a b for the title and a span for the line, inside [data-toasts]
   *   [data-open]   the touch Open button: shown while it has .is-active
   *
   * Nothing here blurs what is behind it. A backdrop-filter over a canvas that repaints at 144 Hz
   * cost 37 extra missed frames in 80 s, so every fill is solid and nearly opaque instead.
   */
  body.is-bare {
    /* The fill of everything that floats over the canvas. */
    --fill: rgba(10, 10, 10, 0.86);
    /* Clear of the notch, the rounded corners and the home indicator. */
    --top: max(1rem, env(safe-area-inset-top));
    --left: max(var(--gutter), env(safe-area-inset-left));
    --right: max(var(--gutter), env(safe-area-inset-right));
    --bottom: max(var(--gutter), env(safe-area-inset-bottom) + 0.5rem);
    overflow: hidden;
    height: 100svh;
    overscroll-behavior: none;
    touch-action: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* The classes below set display, which would otherwise outrank the hidden attribute. */
  [hidden] {
    display: none !important;
  }

  [data-canvas] {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    outline: none;
  }

  /* --- Full-screen states ------------------------------------------- */
  .screen {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: grid;
    /* Safe: on a phone held sideways the intro is taller than the screen, and scrolls. */
    align-content: center;
    align-content: safe center;
    justify-items: center;
    gap: 1rem;
    overflow-y: auto;
    touch-action: pan-y;
    text-align: center;
    padding: 2rem var(--gutter);
    background:
      radial-gradient(55% 45% at 50% 40%, rgba(41, 151, 255, 0.16), transparent 70%),
      rgba(0, 0, 0, 0.92);
  }

  /*
   * Start fades the intro off the world that has been running behind it. A browser that cannot
   * transition display drops the whole declaration, and there the intro just goes.
   */
  [data-intro] {
    transition:
      opacity 0.4s var(--ease),
      display 0.4s allow-discrete;
  }
  [data-intro][hidden] {
    opacity: 0;
    pointer-events: none;
  }

  /* Opaque: it can go up over a game that stopped mid-drive with its HUD still showing. */
  [data-fallback] {
    background-color: #000;
  }

  .mono {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .screen h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 700;
    background: linear-gradient(180deg, #fff 20%, #9b9ba1 120%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .blurb {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .keys {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.5rem;
    /* Two rows of four: the keys that drive, then the keys that do something. */
    max-width: 30rem;
    list-style: none;
    margin: 1rem 0 0.5rem;
    padding: 0;
  }
  .keys li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }
  kbd {
    font: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding-inline: 5px;
    border-radius: 5px;
    color: var(--text);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--hairline-strong);
  }

  .start {
    margin-top: 0.75rem;
    padding: 0.95rem 2rem;
    border: 0;
    border-radius: 980px;
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.25s var(--ease),
      transform 0.25s var(--ease);
  }
  .start:hover {
    background: var(--accent-hi);
  }
  .start:active {
    transform: scale(0.97);
  }

  .credit {
    margin: 0.5rem 0 0;
    font-size: 0.6875rem;
    color: var(--text-dim);
  }
  .credit a {
    color: var(--text-muted);
  }

  .exit {
    font-size: 0.8125rem;
    color: var(--text-dim);
    text-decoration: none;
  }
  .exit:hover {
    color: var(--text);
  }

  .bar {
    width: min(260px, 60vw);
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.25s var(--ease);
  }

  /* --- HUD ----------------------------------------------------------- */
  .hud {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /* Chips that do not fit drop to a second row under the others, not under Exit. */
    justify-content: flex-end;
    gap: 0.5rem;
    padding: var(--top) var(--right) 0 var(--left);
    pointer-events: none;
  }
  .hud > * {
    pointer-events: auto;
  }
  /*
   * Buttons on the left and chips on the right, whatever order they were appended in. The space
   * between the two groups is this spacer, which a phone turns into a line break.
   */
  .hud > .hud-btn {
    order: 1;
  }
  .hud::after {
    content: '';
    order: 2;
    flex: 1 1 0;
  }
  .hud > .hud-stat {
    order: 3;
  }

  .hud-btn {
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 550;
    line-height: 1.5;
    padding: 0.45rem 0.9rem;
    border-radius: 980px;
    color: var(--text);
    background: var(--fill);
    border: 1px solid var(--hairline);
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .hud-btn:hover {
    border-color: var(--hairline-strong);
  }
  .hud-btn[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }

  .hud-stat {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.4rem 0.9rem;
    border-radius: 980px;
    background: var(--fill);
    border: 1px solid var(--hairline);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .hud-stat b {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .hud-stat span {
    font-size: 0.6875rem;
    color: var(--text-muted);
  }
  /* Three digits wide, so the row does not shuffle each time the speed passes 10 and 100. */
  [data-speed] {
    min-width: 3ch;
    text-align: right;
  }

  /* Out of the row: bottom left, where a phone has its stick. */
  .hud-tip {
    display: none;
    position: fixed;
    left: var(--left);
    bottom: var(--bottom);
    margin: 0;
    padding: 0.45rem 0.9rem;
    border-radius: 980px;
    background: var(--fill);
    border: 1px solid var(--hairline);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* --- Pad panels ------------------------------------------------------ */
  [data-panel] {
    position: fixed;
    z-index: 15;
  }
  /* Every pad's panel is stacked on the same spot, and one of them is open. */
  .panel {
    position: absolute;
    inset: auto 0 0;
    padding: 1.4rem;
    border-radius: 20px;
    background: rgba(10, 10, 12, 0.94);
    border: 1px solid var(--hairline-strong);
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px);
    /* Closing is the quicker of the two, so two panels swapping never read as one. */
    transition:
      opacity 0.15s var(--ease),
      transform 0.15s var(--ease),
      visibility 0s 0.15s;
  }
  .panel.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
  }
  .panel .panel-kicker {
    margin: 0 0 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .panel h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .panel .panel-desc {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .panel .panel-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
  }
  .panel .panel-tech li {
    font-size: 0.6875rem;
    color: var(--text-muted);
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--hairline);
    border-radius: 980px;
  }
  /* A site pad has no description and no tags: built empty, they take no room. */
  .panel .panel-desc:empty,
  .panel .panel-tech:empty {
    display: none;
  }
  .panel .panel-shot {
    display: block;
    width: 100%;
    /* The cards are 900 x 563 and arrive late: the box is theirs from the start. */
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin-top: 0.85rem;
    border-radius: 10px;
    border: 1px solid var(--hairline);
    background: var(--surface);
  }
  .panel .panel-links {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-top: 0.9rem;
  }
  .panel .panel-links a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }
  .panel .panel-links a:hover {
    color: var(--accent-hi);
  }
  /* The live site is the point of the pad, so it is the button and the
     gallery link is the aside, not two links of equal weight. */
  .panel .panel-links a.primary {
    padding: 0.42rem 0.85rem;
    border-radius: 999px;
    background: var(--accent);
    color: #06121f;
    font-weight: 600;
  }
  .panel .panel-links a.primary:hover {
    background: var(--accent-hi);
    color: #06121f;
  }
  .panel .panel-links a.muted {
    color: #97a2b2;
  }
  /* The directory: every other site under category headings, one scrolling list inside the
     card. The directory module sets up the list (class and headings) on the first visit. */
  .panel .panel-links.is-index {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    max-height: min(40vh, 21rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    /* The page turns touch scrolling off, and the list is the one thing a thumb should move. */
    touch-action: pan-y;
    scrollbar-width: thin;
    scrollbar-color: var(--hairline-strong) transparent;
  }
  .panel .panel-links.is-index a {
    padding: 0.35rem 0;
  }
  .panel .panel-group {
    margin: 0.7rem 0 0.15rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--hairline);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .panel .panel-group:first-child {
    margin-top: 0;
  }
  .panel .panel-enter {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.9rem 0 0;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* --- Toasts ---------------------------------------------------------- */
  [data-toasts] {
    position: fixed;
    inset: calc(var(--top) + 3.25rem) var(--right) auto var(--left);
    z-index: 16;
    display: grid;
    justify-items: center;
    pointer-events: none;
  }
  .toast {
    /* One spot, however many the queue leaves in the container. */
    grid-area: 1 / 1;
    display: grid;
    gap: 0.1rem;
    max-width: 100%;
    padding: 0.6rem 1.2rem;
    border-radius: 16px;
    background: var(--fill);
    border: 1px solid var(--hairline-strong);
    text-align: center;
    /* The whole life of a toast: the queue moves on at animationend. */
    animation: toast 4s var(--ease-out) both;
  }
  .toast b {
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--text);
  }
  .toast span {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  @keyframes toast {
    0%,
    100% {
      opacity: 0;
      transform: translateY(-12px);
    }
    8%,
    92% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes toast-still {
    0%,
    100% {
      opacity: 0;
    }
    8%,
    92% {
      opacity: 1;
    }
  }

  /* --- Touch controls -------------------------------------------------- */
  [data-stick],
  [data-brake],
  [data-boost],
  [data-open] {
    position: fixed;
    z-index: 15;
    touch-action: none;
  }
  /* They come and go with the HUD: nothing to steer before Start. */
  .hud[hidden] ~ :is([data-stick], [data-brake], [data-boost], [data-open]) {
    display: none;
  }

  [data-stick] {
    left: var(--left);
    bottom: var(--bottom);
    display: grid;
    place-items: center;
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: rgba(10, 10, 10, 0.55);
    border: 1px solid var(--hairline);
    opacity: 0.6;
    transition: opacity 0.3s var(--ease);
  }
  [data-stick][data-active] {
    opacity: 1;
  }
  [data-knob] {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(41, 151, 255, 0.85);
    box-shadow: 0 6px 20px -6px rgba(41, 151, 255, 0.9);
    pointer-events: none;
  }

  /* Pedal order: the brake to the left of the one that makes it go. */
  [data-brake],
  [data-boost] {
    bottom: var(--bottom);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    font: inherit;
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    background: rgba(10, 10, 10, 0.55);
    border: 1px solid var(--hairline-strong);
  }
  [data-boost] {
    right: var(--right);
  }
  [data-brake] {
    right: calc(var(--right) + 64px + 0.625rem);
  }
  [data-brake]:active,
  [data-boost]:active {
    background: var(--accent);
    border-color: var(--accent);
  }

  /* Above the two of them and as wide, when the pad under the car has a link. */
  [data-open] {
    right: var(--right);
    bottom: calc(var(--bottom) + 64px + 0.625rem);
    width: calc(128px + 0.625rem);
    height: 44px;
    border-radius: 980px;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #06121f;
    background: var(--accent);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.15s var(--ease),
      transform 0.15s var(--ease),
      visibility 0s 0.15s;
  }
  [data-open].is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }

  /* --- Fade ------------------------------------------------------------ */
  /* Over the canvas and under the HUD: the world blinks, the chrome does not. */
  [data-fade] {
    position: fixed;
    inset: 0;
    z-index: 5;
    background: #000;
    opacity: 0;
    pointer-events: none;
  }

  /* --- A mouse and a keyboard ------------------------------------------ */
  @media (hover: hover) and (pointer: fine) {
    [data-stick],
    [data-brake],
    [data-boost],
    [data-open] {
      display: none;
    }
    [data-panel] {
      right: var(--right);
      bottom: var(--bottom);
      width: min(380px, 100vw - 2 * var(--gutter));
    }
    @media (min-width: 900px) {
      .hud-tip {
        display: block;
      }
    }
  }

  /* --- Touch ----------------------------------------------------------- */
  @media not all and (hover: hover) and (pointer: fine) {
    /* A sheet above the stick, between the gutters. */
    [data-panel] {
      left: var(--left);
      right: var(--right);
      bottom: calc(var(--bottom) + 132px + 0.625rem);
      max-width: 420px;
      margin-inline: auto;
    }
    /* A tablet has room between the stick and the pedals instead. */
    @media (min-width: 660px) {
      [data-panel] {
        left: calc(var(--left) + 132px + 0.625rem);
        right: calc(var(--right) + 128px + 1.25rem);
        bottom: var(--bottom);
      }
    }
    /*
     * The sheet lies between the parked car and the thumbs, and on a 390 x 844 phone that gap is
     * 166 px. So the card (a site has one) or the tags (Axiom has those) go beside the name and
     * not under it, the description stops at two lines, and the E hint goes, since Open is under
     * the right thumb.
     */
    .panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 0.75rem;
      padding: 0.9rem 1rem;
      border-radius: 16px;
    }
    .panel > * {
      grid-column: 1;
    }
    .panel h2 {
