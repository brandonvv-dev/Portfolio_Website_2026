---
import Layout from '../layouts/Layout.astro';
---

<Layout
  bare
  title="Drive my CV — Brandon van Vuuren"
  description="Brandon van Vuuren's CV as a drivable 3D world. WASD to drive, drive over a project to open it."
>
  <canvas data-canvas tabindex="0" aria-label="Drivable 3D portfolio"></canvas>

  <!-- Loading -->
  <div class="screen" data-loading>
    <p class="mono">Loading the world</p>
    <div class="bar"><i data-progress></i></div>
  </div>

  <!-- Intro -->
  <div class="screen" data-intro hidden>
    <p class="mono">Brandon van Vuuren</p>
    <h1>Drive my CV.</h1>
    <p class="blurb">
      Twenty client sites are laid out on the floor. Drive onto one to open it,
      follow the avenue to the finish for the PDF, and wreck the playground on
      the way — it keeps score.
    </p>

    <p class="recap" data-recap hidden></p>

    <ul class="keys">
      <li><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd><span>Drive</span></li>
      <li><kbd>Space</kbd><span>Drift</span></li>
      <li><kbd>S</kbd><span>Brake / reverse</span></li>
      <li><kbd>L</kbd><span>Lights</span></li>
      <li><kbd>R</kbd><span>Reset</span></li>
      <li><kbd>H</kbd><span>Horn</span></li>
    </ul>

    <button data-start class="start" type="button">Start driving</button>
    <a class="exit" href="/">Back to the normal site</a>
    <p class="credit">Vehicle model by <a href="https://kenney.nl" target="_blank" rel="noopener">Kenney</a> (CC0)</p>
  </div>

  <!-- No WebGL -->
  <div class="screen" data-fallback hidden>
    <h1>Your browser can&rsquo;t run the 3D version.</h1>
    <p class="blurb">No problem — here&rsquo;s the same CV, flat.</p>
    <a class="start" href="/assets/CV Brandon van Vuuren.pdf" target="_blank" rel="noopener">
      Open the PDF
    </a>
    <a class="exit" href="/">Back to the normal site</a>
  </div>

  <!-- In-game chrome -->
  <div class="hud" data-hud hidden>
    <a class="hud-btn" href="/">‹ Exit</a>
    <button class="hud-btn" data-reset type="button">Reset</button>
    <button class="hud-btn" data-sound type="button" aria-pressed="false">Sound off</button>
    <button class="hud-btn" data-night type="button" aria-pressed="false">Day</button>
    <button class="hud-btn hud-touch" data-tilt type="button" aria-pressed="false">Tilt</button>
    <p class="hud-tip">WASD · <kbd>Space</kbd> + throttle to drift · <kbd>L</kbd> lights · <kbd>R</kbd> reset</p>
    <div class="hud-stat hud-first" title="Sites driven onto"><b data-found>0/20</b><span>sites</span></div>
    <div class="hud-stat" title="Secrets found"><b data-secrets>0/3</b><span>secret</span></div>
    <div class="hud-stat" title="Props knocked over"><b data-score>0/0</b><span>hit</span></div>
    <div class="hud-stat"><b data-speed>0</b><span>km/h</span></div>
  </div>

  <p class="toast" data-toast hidden></p>

  <aside class="panel" data-panel hidden></aside>

  <div class="vignette" aria-hidden="true"></div>

  <div class="stick" data-stick hidden>
    <span data-knob></span>
  </div>

  <!-- Touch pedals: a bigger target than a stick axis on a phone -->
  <div class="pedals" data-pedals hidden>
    <button class="pedal" data-brake type="button" aria-label="Brake">■</button>
    <button class="pedal" data-reverse type="button" aria-label="Reverse">▼</button>
    <button class="pedal pedal-go" data-gas type="button" aria-label="Accelerate">▲</button>
  </div>

  <script>
    import '../game/main.ts';
  </script>
</Layout>

<style is:global>
  body.is-bare {
    overflow: hidden;
    height: 100svh;
    overscroll-behavior: none;
    touch-action: none;
  }
</style>

<style>
  canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    outline: none;
  }

  /* --- Full-screen states ------------------------------------------- */
  .screen {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 1rem;
    text-align: center;
    padding: 2rem var(--gutter);
    background:
      radial-gradient(55% 45% at 50% 40%, rgba(41, 151, 255, 0.16), transparent 70%),
      rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(8px);
  }
  .screen[hidden] {
    display: none;
  }

  .mono {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .screen h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 700;
    background: linear-gradient(180deg, #fff 20%, #9b9ba1 120%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .blurb {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .keys {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.5rem;
    list-style: none;
    margin: 1rem 0 0.5rem;
    padding: 0;
  }
  .keys li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }
  kbd {
    font: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding-inline: 5px;
    border-radius: 5px;
    color: var(--text);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--hairline-strong);
  }

  .start {
    margin-top: 0.75rem;
    padding: 0.95rem 2rem;
    border: 0;
    border-radius: 980px;
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .start:hover {
    background: var(--accent-hi);
  }
  .start:active {
    transform: scale(0.97);
  }

  .credit {
    margin: 0.5rem 0 0;
    font-size: 0.6875rem;
    color: var(--text-dim);
  }
  .credit a {
    color: var(--text-muted);
  }

  .exit {
    font-size: 0.8125rem;
    color: var(--text-dim);
    text-decoration: none;
  }
  .exit:hover {
    color: var(--text);
  }

  .bar {
    width: min(260px, 60vw);
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.25s var(--ease);
  }

  /* --- HUD ----------------------------------------------------------- */
  .hud {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem var(--gutter);
    pointer-events: none;
  }
  .hud[hidden] {
    display: none;
  }
  .hud > * {
    pointer-events: auto;
  }

  .hud-btn {
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 550;
    padding: 0.45rem 0.9rem;
    border-radius: 980px;
    color: var(--text);
    background: rgba(12, 12, 14, 0.7);
    border: 1px solid var(--hairline);
    backdrop-filter: blur(12px);
    text-decoration: none;
    cursor: pointer;
  }
  .hud-btn:hover {
    border-color: var(--hairline-strong);
  }
  .hud-btn[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }

  .hud-stat {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.4rem 0.9rem;
    border-radius: 980px;
    background: rgba(12, 12, 14, 0.7);
    border: 1px solid var(--hairline);
    backdrop-filter: blur(12px);
    font-variant-numeric: tabular-nums;
  }
  /* First stat pushes the whole readout group to the right-hand edge. */
  .hud-first {
    margin-left: auto;
  }
  .hud-stat b {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    min-width: 2.2ch;
    text-align: right;
  }
  .hud-stat span {
    font-size: 0.6875rem;
    color: var(--text-dim);
  }

  .hud-tip {
    display: none;
    margin: 0;
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  /* --- Toast ---------------------------------------------------------- */
  /* Airtime, secrets and respawns. Deliberately centred and short-lived:
     it is the only thing allowed to interrupt the view. */
  .toast {
    position: fixed;
    z-index: 16;
    top: 18vh;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.55rem 1.3rem;
    border-radius: 980px;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: #fff;
    background: rgba(10, 12, 16, 0.82);
    border: 1px solid var(--hairline-strong);
    backdrop-filter: blur(14px);
    pointer-events: none;
    animation: toast-in 0.3s var(--ease-out) both;
  }
  .toast[hidden] {
    display: none;
  }
  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translate(-50%, 10px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
  }

  /* --- Vignette -------------------------------------------------------- */
  /* Cheaper than a post-processing pass and does the same job: pulls the eye
     to the middle and stops the sky washing out the corners. */
  .vignette {
    position: fixed;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: radial-gradient(
      120% 100% at 50% 42%,
      transparent 42%,
      rgba(6, 8, 12, 0.34) 100%
    );
  }

  .recap {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--accent);
  }
  .recap[hidden] {
    display: none;
  }

  /* --- Project panel -------------------------------------------------- */
  .panel {
    position: fixed;
    z-index: 15;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 1rem;
    max-width: 420px;
    padding: 0.9rem 1.2rem;
    border-radius: 18px;
    background: rgba(10, 10, 12, 0.86);
    border: 1px solid var(--hairline-strong);
    backdrop-filter: blur(20px);
    animation: panel-in 0.45s var(--ease-out) both;
  }
  .panel[hidden] {
    display: none;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>

<style is:global>
  /* Panel contents are injected by the game, so these live in global scope. */
  .panel .panel-kicker {
    margin: 0 0 0.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #2997ff;
  }
  .panel h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: #f5f5f7;
  }
  .panel .panel-links {
    display: flex;
    gap: 1.1rem;
    margin-top: 0.6rem;
  }
  .panel .panel-links a {
    font-size: 0.875rem;
    font-weight: 500;
    color: #2997ff;
    text-decoration: none;
  }
  .panel .panel-links a:hover {
    color: #6cc0ff;
  }
</style>

<style>
  /* --- Touch joystick -------------------------------------------------- */
  .stick {
    position: fixed;
    z-index: 15;
    left: 1.25rem;
    bottom: 1.25rem;
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: rgba(12, 12, 14, 0.5);
    border: 1px solid var(--hairline);
    backdrop-filter: blur(10px);
    display: grid;
    place-items: center;
    touch-action: none;
    transition: opacity 0.3s var(--ease);
    opacity: 0.55;
  }
  .stick[hidden] {
    display: none;
  }
  .stick[data-active] {
    opacity: 1;
  }
  .stick span {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(41, 151, 255, 0.85);
    box-shadow: 0 6px 20px -6px rgba(41, 151, 255, 0.9);
    pointer-events: none;
  }

  /* --- Touch pedals ---------------------------------------------------- */
  .pedals {
    position: fixed;
    z-index: 15;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.6rem;
    touch-action: none;
  }
  .pedals[hidden] {
    display: none;
  }
  .pedal {
    width: 72px;
    height: 72px;
    border-radius: 24px;
    font: inherit;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--text);
    background: rgba(12, 12, 14, 0.5);
    border: 1px solid var(--hairline);
    backdrop-filter: blur(10px);
    opacity: 0.6;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    transition: opacity 0.15s var(--ease), transform 0.15s var(--ease);
  }
  .pedal-go {
    grid-row: span 2;
    height: auto;
    background: rgba(41, 151, 255, 0.35);
    border-color: rgba(41, 151, 255, 0.6);
  }
  .pedal[data-active] {
    opacity: 1;
    transform: scale(0.95);
  }

  /* Desktop: keyboard is the input, so the touch controls go away. */
  @media (hover: hover) and (pointer: fine) {
    .stick,
    .pedals,
    .hud-touch {
      display: none;
    }
    .hud-tip {
      display: block;
    }
    .panel {
      left: auto;
      right: var(--gutter);
      bottom: var(--gutter);
      width: auto;
      max-width: 340px;
    }
  }

  /* Phones: the HUD wraps rather than squeezing the readouts off-screen. */
  @media (max-width: 720px) {
    .hud {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .hud-first {
      margin-left: 0;
    }
    .panel {
      right: auto;
      max-width: none;
      bottom: 8.5rem;
    }
  }
</style>
